<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:installLocation="auto">
	<uses-permission android:name="android.permission.INTERNET" />
	<application android:label="Benny Box" android:icon="@mipmap/icon">
		<!-- Asks Play services to fetch its QR scanner module when the app is installed, rather than on
		     the first tap of Settings' "Scan QR code" (see QrCodeScanner). -->
		<meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="barcode_ui" />
	</application>
</manifest>
