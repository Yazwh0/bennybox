<!-- Namespace is BitMagic.BennyBox.Views, not BitMagic.BennyBox.Android.Views - see LiveTvView.axaml's
     comment for why. Row templates (Channel/Series/Movie/Clip) mirror desktop's SearchView.axaml
     content-for-content, just without the glass-* style classes (Android has no equivalent - see
     App.axaml) and with fixed-size icon buttons instead of MinWidth (see CLAUDE.md's row/tile card
     guidance on why MinWidth shifts sibling buttons as bound glyphs change width). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BitMagic.BennyBox.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:controls="using:BitMagic.BennyBox.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:views="using:BitMagic.BennyBox.Android.Views"
             x:Class="BitMagic.BennyBox.Views.SearchView"
             x:DataType="vm:SearchViewModel"
             x:Name="RootControl">
    <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Spacing="6" Margin="8">
            <TextBox Text="{Binding SearchText}" Watermark="Search Live TV, Series, and Movies..." />
            <TextBlock Text="{Binding LoadError}" Foreground="OrangeRed" TextWrapping="Wrap" IsVisible="{Binding HasLoadError}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLoading}">
            <ui:FAProgressRing IsActive="{Binding IsLoading}" Width="32" Height="32" />
            <TextBlock Text="Loading..." Opacity="0.7" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Type to search across Live TV, Series, and Movies." Margin="16" TextWrapping="Wrap" Opacity="0.7">
            <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                    <Binding Path="!IsLoading" />
                    <Binding Path="HasEmptyQuery" />
                </MultiBinding>
            </TextBlock.IsVisible>
        </TextBlock>
        <TextBlock Grid.Row="1" Text="No matches found." Margin="16" TextWrapping="Wrap" Opacity="0.7">
            <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                    <Binding Path="!IsLoading" />
                    <Binding Path="HasNoMatches" />
                </MultiBinding>
            </TextBlock.IsVisible>
        </TextBlock>

        <ScrollViewer Grid.Row="1" IsVisible="{Binding !IsLoading}">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="vm:CategoryHeaderRow">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="8,12,8,4" />
                    </DataTemplate>
                    <DataTemplate DataType="vm:ChannelListItemViewModel">
                        <Grid ColumnDefinitions="Auto,*" Margin="8,2">
                            <Button Grid.Column="0"
                                    Command="{Binding #RootControl.DataContext.ToggleChannelFavoriteCommand}" CommandParameter="{Binding}"
                                    Width="40" Height="40" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,4,0">
                                <ui:FASymbolIcon Symbol="{Binding IsFavorite, Converter={x:Static views:FavoriteToSymbolConverter.Instance}}" FontSize="16" />
                            </Button>
                            <Button Grid.Column="1" Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Command="{Binding #RootControl.DataContext.SelectChannelCommand}" CommandParameter="{Binding Channel}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <controls:ChannelLogoImage LogoUrl="{Binding Channel.LogoUrl}" FallbackLogoUrl="{Binding FallbackLogoUrl}"
                                                                TmdbFallbackTitle="{Binding Name}" Width="44" Height="44" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Text="{Binding NowTitle}" FontSize="11" Opacity="0.7" IsVisible="{Binding HasNowTitle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </DataTemplate>
                    <DataTemplate DataType="vm:SeriesListItemViewModel">
                        <Grid ColumnDefinitions="Auto,*" Margin="8,2">
                            <Button Grid.Column="0"
                                    Command="{Binding #RootControl.DataContext.ToggleSeriesFavoriteCommand}" CommandParameter="{Binding}"
                                    Width="40" Height="40" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,4,0">
                                <ui:FASymbolIcon Symbol="{Binding IsFavorite, Converter={x:Static views:FavoriteToSymbolConverter.Instance}}" FontSize="16" />
                            </Button>
                            <Button Grid.Column="1" Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Command="{Binding #RootControl.DataContext.SelectSeriesCommand}" CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal" Spacing="8" Opacity="{Binding ContentOpacity}">
                                    <controls:ChannelLogoImage LogoUrl="{Binding CoverUrl}" Width="44" Height="44" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </DataTemplate>
                    <DataTemplate DataType="vm:MovieListItemViewModel">
                        <Grid ColumnDefinitions="Auto,Auto,Auto,*" Margin="8,2">
                            <Button Grid.Column="0"
                                    Command="{Binding #RootControl.DataContext.ToggleMovieFavoriteCommand}" CommandParameter="{Binding}"
                                    Width="40" Height="40" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,4,0">
                                <ui:FASymbolIcon Symbol="{Binding IsFavorite, Converter={x:Static views:FavoriteToSymbolConverter.Instance}}" FontSize="16" />
                            </Button>
                            <Button Grid.Column="1" ToolTip.Tip="Toggle watched"
                                    Command="{Binding #RootControl.DataContext.ToggleMovieWatchedCommand}" CommandParameter="{Binding}"
                                    Width="40" Height="40" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,4,0">
                                <ui:FASymbolIcon Symbol="{Binding IsWatched, Converter={x:Static views:WatchedToSymbolConverter.Instance}}" FontSize="16" />
                            </Button>
                            <Button Grid.Column="2" ToolTip.Tip="Download to this device"
                                    Command="{Binding #RootControl.DataContext.DownloadMovieCommand}" CommandParameter="{Binding}"
                                    IsEnabled="{Binding CanDownload}" IsVisible="{Binding !IsFromDownloadsProfile}"
                                    Width="40" Height="40" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,4,0">
                                <ui:FASymbolIcon Symbol="{Binding DownloadState, Converter={x:Static views:DownloadStateToSymbolConverter.Instance}}" FontSize="16" />
                            </Button>
                            <Button Grid.Column="3" Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Command="{Binding #RootControl.DataContext.SelectMovieCommand}" CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal" Spacing="8" Opacity="{Binding ContentOpacity}">
                                    <controls:ChannelLogoImage LogoUrl="{Binding CoverUrl}" Width="44" Height="44" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </DataTemplate>
                    <DataTemplate DataType="vm:ClipListItemViewModel">
                        <Grid ColumnDefinitions="Auto,Auto,Auto,*" Margin="8,2">
                            <Button Grid.Column="0"
                                    Command="{Binding #RootControl.DataContext.ToggleClipFavoriteCommand}" CommandParameter="{Binding}"
                                    Width="40" Height="40" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,4,0">
                                <ui:FASymbolIcon Symbol="{Binding IsFavorite, Converter={x:Static views:FavoriteToSymbolConverter.Instance}}" FontSize="16" />
                            </Button>
                            <Button Grid.Column="1" ToolTip.Tip="Toggle watched"
                                    Command="{Binding #RootControl.DataContext.ToggleClipWatchedCommand}" CommandParameter="{Binding}"
                                    Width="40" Height="40" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,4,0">
                                <ui:FASymbolIcon Symbol="{Binding IsWatched, Converter={x:Static views:WatchedToSymbolConverter.Instance}}" FontSize="16" />
                            </Button>
                            <Button Grid.Column="2" ToolTip.Tip="Download to this device"
                                    Command="{Binding #RootControl.DataContext.DownloadClipCommand}" CommandParameter="{Binding}"
                                    IsEnabled="{Binding CanDownload}" IsVisible="{Binding !IsFromDownloadsProfile}"
                                    Width="40" Height="40" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,4,0">
                                <ui:FASymbolIcon Symbol="{Binding DownloadState, Converter={x:Static views:DownloadStateToSymbolConverter.Instance}}" FontSize="16" />
                            </Button>
                            <Button Grid.Column="3" Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Command="{Binding #RootControl.DataContext.SelectClipCommand}" CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal" Spacing="8" Opacity="{Binding ContentOpacity}">
                                    <controls:ChannelLogoImage LogoUrl="{Binding CoverUrl}" Width="44" Height="44" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
