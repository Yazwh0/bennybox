<!-- Namespace is BitMagic.BennyBox.Views, not BitMagic.BennyBox.Android.Views - see LiveTvView.axaml's
     comment for why. One search box across everything; results come back grouped (Live TV, Series,
     Movies, Clips) and are laid out the same way as their own pages: channels as compact rows (more
     columns on wider screens), shows / films / videos as posters. Press and hold a poster for its
     options (favourite, watched, download). -->
<views:MixedGridView xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BitMagic.BennyBox.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:controls="using:BitMagic.BennyBox.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:views="using:BitMagic.BennyBox.Android.Views"
             x:Class="BitMagic.BennyBox.Views.SearchView"
             x:DataType="vm:SearchViewModel"
             x:Name="RootControl">
    <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" x:Name="FilterPanel" Spacing="4" Margin="12,8,12,4" HorizontalAlignment="Left">
            <TextBox Text="{Binding SearchText}" Watermark="Search channels, shows and films" />
            <TextBlock Text="{Binding LoadError}" Foreground="OrangeRed" TextWrapping="Wrap" IsVisible="{Binding HasLoadError}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLoading}">
            <ui:FAProgressRing IsActive="{Binding IsLoading}" Width="32" Height="32" />
            <TextBlock Text="Loading..." Opacity="0.7" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Type to search channels, shows, films and videos." Margin="16" TextWrapping="Wrap" Opacity="0.7">
            <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                    <Binding Path="!IsLoading" />
                    <Binding Path="HasEmptyQuery" />
                </MultiBinding>
            </TextBlock.IsVisible>
        </TextBlock>
        <TextBlock Grid.Row="1" Text="No matches found." Margin="16" TextWrapping="Wrap" Opacity="0.7">
            <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                    <Binding Path="!IsLoading" />
                    <Binding Path="HasNoMatches" />
                </MultiBinding>
            </TextBlock.IsVisible>
        </TextBlock>

        <ScrollViewer Grid.Row="1" IsVisible="{Binding !IsLoading}" SizeChanged="OnListSizeChanged">
            <ItemsControl x:Name="ResultRows" Margin="12,0,12,12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="vm:CategoryHeaderRow">
                        <TextBlock Classes="title" Text="{Binding Name}" Margin="0,16,0,8" />
                    </DataTemplate>
                    <DataTemplate DataType="views:GridRow">
                        <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="{x:Static views:PosterGrid.Gap}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.DataTemplates>
                                <DataTemplate DataType="vm:ChannelListItemViewModel">
                                    <Border Classes="card" Width="{Binding #RootControl.ColumnWidth}" Padding="8,4,4,4" MinHeight="64">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Button Grid.Column="0" Padding="0" Background="Transparent" BorderThickness="0"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                    Command="{Binding #RootControl.DataContext.SelectChannelCommand}" CommandParameter="{Binding Channel}">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <Border Width="48" Height="48" CornerRadius="8" ClipToBounds="True" VerticalAlignment="Center"
                                                            Background="{DynamicResource M3SurfaceContainerHighBrush}">
                                                        <controls:ChannelLogoImage LogoUrl="{Binding Channel.LogoUrl}" FallbackLogoUrl="{Binding FallbackLogoUrl}"
                                                                                   TmdbFallbackTitle="{Binding Name}" Margin="2" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Left" Text="⚠" Foreground="#FFB300" Margin="0,0,6,0"
                                                                       IsVisible="{Binding DidNotWork}" />
                                                            <views:SimplePictureIcon DockPanel.Dock="Left" Picture="NotOnThisDevice" Width="20" Height="20" CornerRadius="10" Margin="0,0,6,0"
                                                                                     VerticalAlignment="Center" IsVisible="{Binding CannotPlayHere}" ToolTip.Tip="Won't play on this device" />
                                                            <TextBlock Text="{Binding Name}" FontSize="15" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding NowTitle}" FontSize="12" Opacity="0.8" TextTrimming="CharacterEllipsis"
                                                                   IsVisible="{Binding HasNowTitle}" />
                                                        <ProgressBar Value="{Binding NowProgress}" Minimum="0" Maximum="1" Height="3" MinWidth="0" Margin="0,2,8,2"
                                                                     IsVisible="{Binding HasNowProgress}" />
                                                        <TextBlock Text="{Binding NextLine}" FontSize="12" Opacity="0.6" TextTrimming="CharacterEllipsis"
                                                                   IsVisible="{Binding HasNextLine}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                            <Button Grid.Column="1" Classes="icon" ToolTip.Tip="Favourite"
                                                    Command="{Binding #RootControl.DataContext.ToggleChannelFavoriteCommand}" CommandParameter="{Binding}">
                                                <ui:FASymbolIcon Symbol="{Binding IsFavorite, Converter={x:Static views:FavoriteToSymbolConverter.Instance}}" FontSize="18" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>

                                <DataTemplate DataType="vm:SeriesListItemViewModel">
                                    <Button Classes="poster" Width="{Binding #RootControl.TileWidth}"
                                            Click="OnPosterClick" ContextRequested="OnPosterContextRequested">
                                        <Button.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuItem Header="{Binding IsFavorite, Converter={x:Static views:BrowseConverters.FavouriteMenuText}}"
                                                          Command="{Binding #RootControl.DataContext.ToggleSeriesFavoriteCommand}" CommandParameter="{Binding}" />
                                            </MenuFlyout>
                                        </Button.ContextFlyout>
                                        <views:PosterTile Width="{Binding #RootControl.TileWidth}" PosterHeight="{Binding #RootControl.PosterHeight}"
                                                          Title="{Binding Name}" ImageUrl="{Binding CoverUrl}" IsFavourite="{Binding IsFavorite}"
                                                          Opacity="{Binding ContentOpacity}" />
                                    </Button>
                                </DataTemplate>

                                <DataTemplate DataType="vm:MovieListItemViewModel">
                                    <Button Classes="poster" Width="{Binding #RootControl.TileWidth}"
                                            Click="OnPosterClick" ContextRequested="OnPosterContextRequested">
                                        <Button.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuItem Header="{Binding IsFavorite, Converter={x:Static views:BrowseConverters.FavouriteMenuText}}"
                                                          Command="{Binding #RootControl.DataContext.ToggleMovieFavoriteCommand}" CommandParameter="{Binding}" />
                                                <MenuItem Header="{Binding IsWatched, Converter={x:Static views:BrowseConverters.WatchedMenuText}}"
                                                          Command="{Binding #RootControl.DataContext.ToggleMovieWatchedCommand}" CommandParameter="{Binding}" />
                                                <MenuItem Header="Download to this device" IsEnabled="{Binding CanDownload}" IsVisible="{Binding !IsFromDownloadsProfile}"
                                                          Command="{Binding #RootControl.DataContext.DownloadMovieCommand}" CommandParameter="{Binding}" />
                                            </MenuFlyout>
                                        </Button.ContextFlyout>
                                        <views:PosterTile Width="{Binding #RootControl.TileWidth}" PosterHeight="{Binding #RootControl.PosterHeight}"
                                                          Title="{Binding Name}" ImageUrl="{Binding CoverUrl}" IsFavourite="{Binding IsFavorite}"
                                                          DidNotWork="{Binding DidNotWork}" CannotPlayHere="{Binding CannotPlayHere}" Opacity="{Binding ContentOpacity}" />
                                    </Button>
                                </DataTemplate>

                                <DataTemplate DataType="vm:ClipListItemViewModel">
                                    <Button Classes="poster" Width="{Binding #RootControl.TileWidth}"
                                            Click="OnPosterClick" ContextRequested="OnPosterContextRequested">
                                        <Button.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuItem Header="{Binding IsFavorite, Converter={x:Static views:BrowseConverters.FavouriteMenuText}}"
                                                          Command="{Binding #RootControl.DataContext.ToggleClipFavoriteCommand}" CommandParameter="{Binding}" />
                                                <MenuItem Header="{Binding IsWatched, Converter={x:Static views:BrowseConverters.WatchedMenuText}}"
                                                          Command="{Binding #RootControl.DataContext.ToggleClipWatchedCommand}" CommandParameter="{Binding}" />
                                                <MenuItem Header="Download to this device" IsEnabled="{Binding CanDownload}" IsVisible="{Binding !IsFromDownloadsProfile}"
                                                          Command="{Binding #RootControl.DataContext.DownloadClipCommand}" CommandParameter="{Binding}" />
                                            </MenuFlyout>
                                        </Button.ContextFlyout>
                                        <views:PosterTile Width="{Binding #RootControl.TileWidth}" PosterHeight="{Binding #RootControl.PosterHeight}"
                                                          Title="{Binding Name}" ImageUrl="{Binding CoverUrl}" IsFavourite="{Binding IsFavorite}"
                                                          DidNotWork="{Binding DidNotWork}" CannotPlayHere="{Binding CannotPlayHere}" Opacity="{Binding ContentOpacity}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.DataTemplates>
                        </ItemsControl>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</views:MixedGridView>
