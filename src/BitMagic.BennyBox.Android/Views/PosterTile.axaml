<!-- One poster in a normal-mode grid (Search, Favourites, Downloads): the cover at 2:3 with big initials
     behind it while it loads (or when there isn't one), a star when it's a favourite, a red "!" when
     it didn't play last time, an optional progress bar along the bottom (part-watched, downloading),
     then a two-line title and an optional small line under it. The surrounding Button (Classes="poster")
     does the tapping and holding. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:controls="using:BitMagic.BennyBox.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:views="using:BitMagic.BennyBox.Android.Views"
             x:Class="BitMagic.BennyBox.Android.Views.PosterTile"
             x:DataType="views:PosterTile"
             x:Name="Root">
    <StackPanel Spacing="6">
        <Border Height="{Binding #Root.PosterHeight}" CornerRadius="10" ClipToBounds="True"
                Background="{DynamicResource M3SurfaceContainerHighBrush}">
            <Panel>
                <TextBlock Text="{Binding #Root.Title, Converter={x:Static views:SimpleModeConverters.Initials}}"
                           FontSize="28" FontWeight="Bold" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <controls:ChannelLogoImage LogoUrl="{Binding #Root.ImageUrl}" Stretch="UniformToFill" />
                <Border IsVisible="{Binding #Root.IsFavourite}" Width="28" Height="28" CornerRadius="14" Margin="6"
                        Background="#B3000000" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <ui:FASymbolIcon Symbol="StarFilled" FontSize="14" Foreground="#FFCA28" />
                </Border>
                <Border IsVisible="{Binding #Root.DidNotWork}" Width="28" Height="28" CornerRadius="14" Margin="6"
                        Background="#C62828" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <TextBlock Text="!" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <views:SimplePictureIcon Picture="NotOnThisDevice" IsVisible="{Binding #Root.CannotPlayHere}" Width="28" Height="28" CornerRadius="14" Margin="6"
                                         HorizontalAlignment="Left" VerticalAlignment="Top" />
                <ProgressBar IsVisible="{Binding #Root.Progress, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                             Value="{Binding #Root.Progress}" Minimum="0" Maximum="1" Height="4" MinWidth="0" CornerRadius="0"
                             VerticalAlignment="Bottom" />
            </Panel>
        </Border>
        <TextBlock Text="{Binding #Root.Title}" FontSize="13" TextWrapping="Wrap" MaxLines="2" Height="36" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding #Root.Subtitle}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding #Root.Subtitle, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
</UserControl>
