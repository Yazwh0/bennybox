<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BitMagic.BennyBox.Android.ViewModels"
             xmlns:views="using:BitMagic.BennyBox.Android.Views"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="BitMagic.BennyBox.Android.Views.AndroidShellView"
             x:DataType="vm:AndroidShellViewModel">
    <!-- Every :pointerover/:pressed below sets the ContentPresenter's Background explicitly: Fluent's
         own grey hover/press states otherwise flash through (see CLAUDE.md's styling notes). -->
    <UserControl.Styles>
        <Style Selector="Button.tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tab:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.tab:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.pill">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <!-- M3 navigation bar: the active destination's icon sits in a secondary-container pill. -->
        <Style Selector="Border.pill.active">
            <Setter Property="Background" Value="{DynamicResource M3SecondaryContainerBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource M3OnSecondaryContainerBrush}" />
        </Style>
        <Style Selector="TextBlock.tab-label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.more-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="MinHeight" Value="52" />
        </Style>

        <Style Selector="Button.transport">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.transport:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#55FFFFFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.transport:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#77FFFFFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.transport:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="Foreground" Value="#66FFFFFF" />
        </Style>
        <!-- Play/pause keeps FluentAvalonia's own accent fill (the theme accent, as on checkboxes);
             these just stop the white transport wash above replacing it on hover/press. -->
        <Style Selector="Button.transport.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="Button.transport.accent:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
        </Style>

        <!-- Simple picture mode's player buttons: big rounded tiles with an icon over one word. -->
        <Style Selector="Button.simple-control">
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Padding" Value="4,12" />
            <Setter Property="MinHeight" Value="96" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.simple-control:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.simple-control:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#66FFFFFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.simple-control:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="Foreground" Value="#66FFFFFF" />
        </Style>
        <Style Selector="Button.simple-control.play">
            <Setter Property="Background" Value="{DynamicResource M3PrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnPrimaryBrush}" />
        </Style>
        <Style Selector="Button.simple-control.play:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource M3PrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnPrimaryBrush}" />
        </Style>
        <Style Selector="Button.simple-control.play:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource M3PrimaryContainerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnPrimaryContainerBrush}" />
        </Style>
    </UserControl.Styles>
    <Panel Background="{DynamicResource M3SurfaceBrush}">
        <Grid RowDefinitions="*,Auto" IsVisible="{Binding !Settings.IsSimpleMode}">
            <ContentControl Grid.Row="0" Content="{Binding CurrentPage}" />

            <!-- Bottom navigation bar, following Material Design's navigation bar guidance: 3 to 5
                 destinations on a phone, each a 24dp icon in a pill-shaped active indicator with a 12sp
                 label, and at least 48dp tall to tap. Nine tabs don't fit a phone's width, so on narrow
                 screens Search, Clips, Downloads, Favorites and Settings move into the "More" menu
                 (OnTabBarSizeChanged decides which tabs show; the x:Name'd ones are the overflow set).
                 Wide screens (600dp and up, i.e. tablets) show all nine and no More. Active-tab
                 highlighting mirrors desktop's ActiveTagToBackgroundConverter (see ActiveTabConverters.cs);
                 More's parameter lists every overflow tag so it lights up when one of those is open. -->
            <Border Grid.Row="1" Background="{DynamicResource M3SurfaceContainerBrush}">
                <UniformGrid x:Name="TabBar" Rows="1" Margin="0,6" SizeChanged="OnTabBarSizeChanged">
                    <Button Classes="tab" x:Name="SearchTab" Command="{Binding NavigateCommand}" CommandParameter="Search">
                        <StackPanel Spacing="4">
                            <Border Classes="pill" Classes.active="{Binding CurrentPageTag, Converter={x:Static views:ActiveTabToBoolConverter.Instance}, ConverterParameter=Search}">
                                <ui:FASymbolIcon Symbol="Find" FontSize="22" />
                            </Border>
                            <TextBlock Classes="tab-label" Text="Search"
                                       FontWeight="{Binding CurrentPageTag, Converter={x:Static views:ActiveTabToFontWeightConverter.Instance}, ConverterParameter=Search}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tab" Command="{Binding NavigateCommand}" CommandParameter="LiveTv">
                        <StackPanel Spacing="4">
                            <Border Classes="pill" Classes.active="{Binding CurrentPageTag, Converter={x:Static views:ActiveTabToBoolConverter.Instance}, ConverterParameter=LiveTv}">
                                <ui:FASymbolIcon Symbol="Video" FontSize="22" />
                            </Border>
                            <TextBlock Classes="tab-label" Text="Live TV"
                                       FontWeight="{Binding CurrentPageTag, Converter={x:Static views:ActiveTabToFontWeightConverter.Instance}, ConverterParameter=LiveTv}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tab" Command="{Binding NavigateCommand}" CommandParameter="Guide">
                        <StackPanel Spacing="4">
                            <Border Classes="pill" Classes.active="{Binding CurrentPageTag, Converter={x:Static views:ActiveTabToBoolConverter.Instance}, ConverterParameter=Guide}">
                                <ui:FASymbolIcon Symbol="CalendarDay" FontSize="22" />
                            </Border>
                            <TextBlock Classes="tab-label" Text="Guide"
                                       FontWeight="{Binding CurrentPageTag, Converter={x:Static views:ActiveTabToFontWeightConverter.Instance}, ConverterParameter=Guide}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tab" Command="{Binding NavigateCommand}" CommandParameter="Series">
                        <StackPanel Spacing="4">
                            <Border Classes="pill" Classes.active="{Binding CurrentPageTag, Converter={x:Static views:ActiveTabToBoolConverter.Instance}, ConverterParameter=Series}">
                                <ui:FASymbolIcon Symbol="List" FontSize="22" />
                            </Border>
                            <TextBlock Classes="tab-label" Text="Series"
                                       FontWeight="{Binding CurrentPageTag, Converter={x:Static views:ActiveTabToFontWeightConverter.Instance}, ConverterParameter=Series}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tab" Command="{Binding NavigateCommand}" CommandParameter="Movies">
                        <StackPanel Spacing="4">
                            <Border Classes="pill" Classes.active="{Binding CurrentPageTag, Converter={x:Static views:ActiveTabToBoolConverter.Instance}, ConverterParameter=Movies}">
                                <ui:FASymbolIcon Symbol="Library" FontSize="22" />
                            </Border>
                            <TextBlock Classes="tab-label" Text="Movies"
                                       FontWeight="{Binding CurrentPageTag, Converter={x:Static views:ActiveTabToFontWeightConverter.Instance}, ConverterParameter=Movies}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tab" x:Name="ClipsTab" Command="{Binding NavigateCommand}" CommandParameter="Clips">
                        <StackPanel Spacing="4">
                            <Border Classes="pill" Classes.active="{Binding CurrentPageTag, Converter={x:Static views:ActiveTabToBoolConverter.Instance}, ConverterParameter=Clips}">
                                <ui:FASymbolIcon Symbol="Flag" FontSize="22" />
                            </Border>
                            <TextBlock Classes="tab-label" Text="Clips"
                                       FontWeight="{Binding CurrentPageTag, Converter={x:Static views:ActiveTabToFontWeightConverter.Instance}, ConverterParameter=Clips}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tab" x:Name="DownloadsTab" Command="{Binding NavigateCommand}" CommandParameter="Downloads">
                        <StackPanel Spacing="4">
                            <Border Classes="pill" Classes.active="{Binding CurrentPageTag, Converter={x:Static views:ActiveTabToBoolConverter.Instance}, ConverterParameter=Downloads}">
                                <ui:FASymbolIcon Symbol="Download" FontSize="22" />
                            </Border>
                            <TextBlock Classes="tab-label" Text="Downloads"
                                       FontWeight="{Binding CurrentPageTag, Converter={x:Static views:ActiveTabToFontWeightConverter.Instance}, ConverterParameter=Downloads}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tab" x:Name="FavoritesTab" Command="{Binding NavigateCommand}" CommandParameter="Favorites">
                        <StackPanel Spacing="4">
                            <Border Classes="pill" Classes.active="{Binding CurrentPageTag, Converter={x:Static views:ActiveTabToBoolConverter.Instance}, ConverterParameter=Favorites}">
                                <ui:FASymbolIcon Symbol="Star" FontSize="22" />
                            </Border>
                            <TextBlock Classes="tab-label" Text="Favorites"
                                       FontWeight="{Binding CurrentPageTag, Converter={x:Static views:ActiveTabToFontWeightConverter.Instance}, ConverterParameter=Favorites}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tab" x:Name="SettingsTab" Command="{Binding NavigateCommand}" CommandParameter="Settings">
                        <StackPanel Spacing="4">
                            <Border Classes="pill" Classes.active="{Binding CurrentPageTag, Converter={x:Static views:ActiveTabToBoolConverter.Instance}, ConverterParameter=Settings}">
                                <ui:FASymbolIcon Symbol="Settings" FontSize="22" />
                            </Border>
                            <TextBlock Classes="tab-label" Text="Settings"
                                       FontWeight="{Binding CurrentPageTag, Converter={x:Static views:ActiveTabToFontWeightConverter.Instance}, ConverterParameter=Settings}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tab" x:Name="MoreTab">
                        <Button.Flyout>
                            <Flyout Placement="TopEdgeAlignedRight">
                                <StackPanel Width="220">
                                    <Button Classes="more-item" Tag="Search" Click="OnMoreItemClick">
                                        <StackPanel Orientation="Horizontal" Spacing="16">
                                            <ui:FASymbolIcon Symbol="Find" FontSize="22" />
                                            <TextBlock Text="Search" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="more-item" Tag="Favorites" Click="OnMoreItemClick">
                                        <StackPanel Orientation="Horizontal" Spacing="16">
                                            <ui:FASymbolIcon Symbol="Star" FontSize="22" />
                                            <TextBlock Text="Favorites" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="more-item" Tag="Clips" Click="OnMoreItemClick">
                                        <StackPanel Orientation="Horizontal" Spacing="16">
                                            <ui:FASymbolIcon Symbol="Flag" FontSize="22" />
                                            <TextBlock Text="Clips" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="more-item" Tag="Downloads" Click="OnMoreItemClick">
                                        <StackPanel Orientation="Horizontal" Spacing="16">
                                            <ui:FASymbolIcon Symbol="Download" FontSize="22" />
                                            <TextBlock Text="Downloads" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="more-item" Tag="Settings" Click="OnMoreItemClick">
                                        <StackPanel Orientation="Horizontal" Spacing="16">
                                            <ui:FASymbolIcon Symbol="Settings" FontSize="22" />
                                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                        <StackPanel Spacing="4">
                            <Border Classes="pill" Classes.active="{Binding CurrentPageTag, Converter={x:Static views:ActiveTabToBoolConverter.Instance}, ConverterParameter=Search|Favorites|Clips|Downloads|Settings}">
                                <ui:FASymbolIcon Symbol="More" FontSize="22" />
                            </Border>
                            <TextBlock Classes="tab-label" Text="More"
                                       FontWeight="{Binding CurrentPageTag, Converter={x:Static views:ActiveTabToFontWeightConverter.Instance}, ConverterParameter=Search|Favorites|Clips|Downloads|Settings}" />
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Border>
        </Grid>

        <!-- Simple picture mode replaces the tabbed app entirely (see SimpleHomeView); the player
             overlay below still covers it when something plays. -->
        <Panel IsVisible="{Binding Settings.IsSimpleMode}">
            <views:SimpleHomeView />
        </Panel>

        <!-- Fullscreen player overlay - shown whenever something is playing, matching desktop's
             "NowPlayingChannelName is the source of truth for whether the video area should be
             visible" convention (see MainWindow.axaml). Phone screens have no room for a permanently-
             docked video area next to the list the way desktop does, so this is a genuine overlay
             instead - closing it (see the Close button) stops playback outright, since there's no
             "minimize and keep browsing while still playing" concept in PlayerViewModel to hook into.
             Video and transport bar are in separate Grid rows, not stacked in the same cell - a
             native view hosted via NativeControlHost (ExoPlayerHostControl) still captures touch
             input in its own bounds regardless of what Avalonia content is drawn on top of it, the
             same "native surface always wins" behavior already documented for desktop's LibVLC
             VideoView (see MainWindow.axaml) - confirmed by taps on the transport bar's Close button
             silently doing nothing while it visually overlapped the native surface's bounds. -->
        <Grid RowDefinitions="*,Auto" Background="Black"
              IsVisible="{Binding Player.NowPlayingChannelName, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
            <Grid Grid.Row="0">
                <views:ExoPlayerHostControl IsVisible="{Binding !Player.ShowLoadingOverlay}" />

                <Border Background="Black" IsVisible="{Binding Player.ShowLoadingOverlay}">
                    <Panel>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" IsVisible="{Binding !Settings.IsSimpleMode}">
                            <TextBlock Text="{Binding Player.StatusText}" Foreground="White" HorizontalAlignment="Center" />
                            <Button Content="Retry" Command="{Binding Player.RetryCommand}" IsVisible="{Binding Player.HasPlaybackError}" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Simple picture mode: a big spinner with the status (e.g. "Buffering (45%)") in large
                             type while loading; if it fails, a warning picture and one big "Try again" instead of
                             the error text (Back is in the bar below). -->
                        <Panel IsVisible="{Binding Settings.IsSimpleMode}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20" IsVisible="{Binding !Player.HasPlaybackError}">
                                <ui:FAProgressRing Width="80" Height="80" IsActive="{Binding Player.ShowLoadingOverlay}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Player.StatusText}" Foreground="White" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24" IsVisible="{Binding Player.HasPlaybackError}">
                                <ui:FASymbolIcon Symbol="Important" FontSize="72" Foreground="White" HorizontalAlignment="Center" />
                                <Button Classes="accent" Command="{Binding Player.RetryCommand}" Click="OnSimpleControlClick" Holding="OnSimpleRetryHolding"
                                        MinHeight="80" Padding="32,12" CornerRadius="40" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <ui:FASymbolIcon Symbol="Refresh" FontSize="32" />
                                        <TextBlock Text="Try again" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Panel>
                    </Panel>
                </Border>

                <!-- Small, unobtrusive - matches ShowBufferingBadge's "don't hide the video for a
                     brief re-buffer" behavior on desktop. -->
                <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="12" Background="#AA000000" CornerRadius="4" Padding="8,4"
                        IsVisible="{Binding Player.ShowBufferingBadge}">
                    <Panel>
                        <TextBlock Text="{Binding Player.StatusText}" Foreground="White" FontSize="12" IsVisible="{Binding !Settings.IsSimpleMode}" />
                        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Settings.IsSimpleMode}">
                            <ui:FAProgressRing Width="28" Height="28" IsActive="{Binding Player.ShowBufferingBadge}" />
                            <TextBlock Text="{Binding Player.StatusText}" Foreground="White" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Panel>
                </Border>

                <!-- Tap-to-reveal catcher for ExitFullscreenButton below - only present while
                     fullscreen, transparent (Background="Transparent" is still hit-testable, unlike
                     null/unset). Toggled rather than "tap to show, auto-hide after N seconds" for now -
                     see OnVideoTapped. Despite sitting in the same Grid cell as ExoPlayerHostControl
                     (a NativeControlHost), this does receive taps fine - unlike desktop's LibVLC
                     VideoView, Android's embedded video surface doesn't appear to always-win hit-testing
                     the way that comment on ExoPlayerHostControl-adjacent desktop code describes; confirmed
                     empirically (ExitFullscreenButton itself already received taps correctly while
                     overlapping the playing video, before this catcher was added). -->
                <Border Background="Transparent" IsVisible="{Binding Player.IsFullscreen}" Tapped="OnVideoTapped" />

                <!-- Hidden by default, shown only via OnVideoTapped (see above) - "only the video
                     visible" until you tap. Top-left so it doesn't collide with the buffering badge's
                     top-right corner. Not the hardware/gesture back action: that was tried first (via
                     Avalonia's BackRequested event) and reliably backgrounded the whole app on this
                     Android version instead of just exiting fullscreen, even with the event confirmed
                     handled - see MainActivity.SetImmersiveFullscreen's comment. -->
                <Button x:Name="ExitFullscreenButton" Classes="transport" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12"
                        Command="{Binding Player.ToggleFullscreenCommand}"
                        IsVisible="False">
                    <ui:FASymbolIcon Symbol="Dismiss" FontSize="20" />
                </Button>
            </Grid>

            <!-- Hidden while fullscreen - matches desktop's TransportBar (see MainWindow.axaml, same
                 !Player.IsFullscreen binding), so fullscreen really is "just the video" (plus the small
                 exit button above). Icon-only buttons (matching desktop's icon-only transport bar - see
                 MainWindow.axaml) instead of the wide text-label buttons this started with - fixed
                 Width/Height + Padding="0", not MinWidth (see CLAUDE.md's row/tile card guidance on why:
                 an icon-only button sized by MinWidth grows/shrinks as whichever bound glyph is
                 currently showing changes advance width, e.g. PlayFilled vs PauseFilled, and the whole
                 row visibly reflows every toggle). -->
            <StackPanel Grid.Row="1" Background="#CC000000" Spacing="4">
                <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                        <Binding Path="!Player.IsFullscreen" />
                        <Binding Path="!Settings.IsSimpleMode" />
                    </MultiBinding>
                </StackPanel.IsVisible>
                <TextBlock Text="{Binding Player.NowPlayingChannelName}" Foreground="White" FontWeight="Bold" Margin="12,8,12,0" TextWrapping="Wrap" />
                <TextBlock Margin="12,0,12,4" Foreground="White" Opacity="0.7" FontSize="12">
                    <Run Text="{Binding Player.PositionLabel}" /><Run Text=" / " /><Run Text="{Binding Player.DurationLabel}" />
                </TextBlock>
                <!-- All the same "transport" style (round, white icon on a translucent wash) so the icons
                     read as one set; play/pause gets the theme accent fill. Skip back/forward are drawn as
                     PathIcons rather than the ⏪/⏩ characters desktop uses: Android renders those as
                     full-colour emoji, which clashed with the monochrome FASymbolIcons around them. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,4,0,16">
                    <Button Classes="transport" Command="{Binding Player.StopCommand}">
                        <ui:FASymbolIcon Symbol="StopFilled" FontSize="20" />
                    </Button>
                    <Button Classes="transport" Command="{Binding Player.SkipBackwardCommand}" IsVisible="{Binding Player.IsSeekable}">
                        <PathIcon Width="20" Height="20" Data="M11,5 L2,12 L11,19 Z M22,5 L13,12 L22,19 Z" />
                    </Button>
                    <Button Classes="transport accent" Command="{Binding Player.TogglePauseCommand}" IsEnabled="{Binding Player.CanPause}">
                        <ui:FASymbolIcon Symbol="{Binding Player.IsPaused, Converter={x:Static views:PausedToPlaySymbolConverter.Instance}}" FontSize="20" />
                    </Button>
                    <Button Classes="transport" Command="{Binding Player.SkipForwardCommand}" IsVisible="{Binding Player.IsSeekable}">
                        <PathIcon Width="20" Height="20" Data="M2,5 L11,12 L2,19 Z M13,5 L22,12 L13,19 Z" />
                    </Button>
                    <Button Classes="transport" Command="{Binding Player.ToggleFullscreenCommand}">
                        <ui:FASymbolIcon Symbol="FullScreenMaximize" FontSize="20" />
                    </Button>
                    <Button Classes="transport" Command="{Binding Player.ToggleMuteCommand}">
                        <ui:FASymbolIcon Symbol="{Binding Player.IsMuted, Converter={x:Static views:MutedToSymbolConverter.Instance}}" FontSize="20" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Simple picture mode's controls (see SimpleHomeView): just Back, Play/Pause, Quieter and
                 Louder, big and always visible, each with a picture and one word. No skip, mute or
                 fullscreen: those are easy to hit by accident and hard to undo without reading.
                 Quieter/Louder move the phone's own media volume (with its usual volume bar), see
                 OnSimpleVolumeClick. Press and hold any of them to hear its name. -->
            <Grid Grid.Row="1" Background="#E6000000" IsVisible="{Binding Settings.IsSimpleMode}"
                  RowDefinitions="Auto,Auto" Margin="0">
                <TextBlock Grid.Row="0" Text="{Binding Player.NowPlayingChannelName}" Foreground="White" FontSize="20" FontWeight="SemiBold"
                           Margin="20,14,20,4" TextTrimming="CharacterEllipsis" MaxLines="1" />
                <UniformGrid Grid.Row="1" Columns="4" Margin="12,8,12,20">
                    <Button Classes="simple-control" Tag="Back" Command="{Binding Player.StopCommand}" Click="OnSimpleControlClick" Holding="OnSimpleControlHolding">
                        <StackPanel Spacing="6">
                            <ui:FASymbolIcon Symbol="Back" FontSize="36" HorizontalAlignment="Center" />
                            <TextBlock Text="Back" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="simple-control" Tag="Quieter" Click="OnSimpleVolumeClick" Holding="OnSimpleControlHolding">
                        <StackPanel Spacing="6">
                            <ui:FASymbolIcon Symbol="Speaker1" FontSize="36" HorizontalAlignment="Center" />
                            <TextBlock Text="Quieter" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="simple-control play" Tag="Play" Command="{Binding Player.TogglePauseCommand}" IsEnabled="{Binding Player.CanPause}"
                            Click="OnSimpleControlClick" Holding="OnSimpleControlHolding">
                        <StackPanel Spacing="6">
                            <ui:FASymbolIcon Symbol="{Binding Player.IsPaused, Converter={x:Static views:PausedToPlaySymbolConverter.Instance}}"
                                             FontSize="40" HorizontalAlignment="Center" />
                            <TextBlock FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Text="{Binding Player.IsPaused, Converter={x:Static views:SimpleModeConverters.PlayPauseLabel}}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="simple-control" Tag="Louder" Click="OnSimpleVolumeClick" Holding="OnSimpleControlHolding">
                        <StackPanel Spacing="6">
                            <ui:FASymbolIcon Symbol="Speaker2" FontSize="36" HorizontalAlignment="Center" />
                            <TextBlock Text="Louder" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Grid>
        </Grid>
    </Panel>
</UserControl>
