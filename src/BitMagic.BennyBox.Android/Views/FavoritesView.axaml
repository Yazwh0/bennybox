<!-- Namespace is BitMagic.BennyBox.Views, not BitMagic.BennyBox.Android.Views - see LiveTvView.axaml's
     comment for why. Mirrors desktop's FavoritesView.axaml row-for-row, adapted to plain controls (no
     glass-* classes/theme brushes - see App.axaml) and the row-card look already established in
     LiveTvView.axaml. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BitMagic.BennyBox.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:controls="using:BitMagic.BennyBox.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:views="using:BitMagic.BennyBox.Android.Views"
             x:Class="BitMagic.BennyBox.Views.FavoritesView"
             x:DataType="vm:FavoritesViewModel"
             x:Name="RootControl">
    <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Text="Favorites" FontSize="20" Margin="8" />
        <StackPanel Grid.Row="1" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLoading}">
            <ui:FAProgressRing IsActive="{Binding IsLoading}" Width="32" Height="32" />
            <TextBlock Text="Loading favorites..." Opacity="0.7" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="No favorites yet - star a channel or series to add it here."
                   Margin="16" TextWrapping="Wrap" Opacity="0.7">
            <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                    <Binding Path="!IsLoading" />
                    <Binding Path="HasNoFavorites" />
                </MultiBinding>
            </TextBlock.IsVisible>
        </TextBlock>
        <ScrollViewer Grid.Row="1" IsVisible="{Binding !IsLoading}">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="vm:CategoryHeaderRow">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="8,12,8,4" />
                    </DataTemplate>
                    <DataTemplate DataType="vm:WatchProgressItemViewModel">
                        <Border Background="#22000000" CornerRadius="6" Margin="8,4" Padding="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="0"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Command="{Binding #RootControl.DataContext.PlayWatchProgressCommand}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <controls:ChannelLogoImage LogoUrl="{Binding CoverUrl}" Width="44" Height="44" VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                            <ProgressBar Value="{Binding ProgressFraction}" Minimum="0" Maximum="1" Width="140" Height="4" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1"
                                        Command="{Binding #RootControl.DataContext.RemoveWatchProgressCommand}" CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0" Width="36" Height="36" Padding="0"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="4,0,0,0">
                                    <ui:FASymbolIcon Symbol="Dismiss" FontSize="16" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                    <DataTemplate DataType="vm:ChannelListItemViewModel">
                        <Border Background="#22000000" CornerRadius="6" Margin="8,4" Padding="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="0"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Command="{Binding #RootControl.DataContext.SelectChannelCommand}" CommandParameter="{Binding Channel}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <controls:ChannelLogoImage LogoUrl="{Binding Channel.LogoUrl}" FallbackLogoUrl="{Binding FallbackLogoUrl}"
                                                                    TmdbFallbackTitle="{Binding Name}" Width="44" Height="44" VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Text="{Binding NowTitle}" FontSize="11" Opacity="0.7" IsVisible="{Binding HasNowTitle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1"
                                        Command="{Binding #RootControl.DataContext.RemoveFavoriteCommand}" CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0" Width="36" Height="36" Padding="0"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="4,0,0,0">
                                    <ui:FASymbolIcon Symbol="StarFilled" FontSize="16" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                    <DataTemplate DataType="vm:SeriesListItemViewModel">
                        <Border Background="#22000000" CornerRadius="6" Margin="8,4" Padding="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="0"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Command="{Binding #RootControl.DataContext.SelectSeriesCommand}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <controls:ChannelLogoImage LogoUrl="{Binding CoverUrl}" Width="44" Height="44" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1"
                                        Command="{Binding #RootControl.DataContext.RemoveSeriesFavoriteCommand}" CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0" Width="36" Height="36" Padding="0"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="4,0,0,0">
                                    <ui:FASymbolIcon Symbol="StarFilled" FontSize="16" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                    <DataTemplate DataType="vm:MovieListItemViewModel">
                        <Border Background="#22000000" CornerRadius="6" Margin="8,4" Padding="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="0"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Command="{Binding #RootControl.DataContext.SelectMovieCommand}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <controls:ChannelLogoImage LogoUrl="{Binding CoverUrl}" Width="44" Height="44" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1"
                                        Command="{Binding #RootControl.DataContext.RemoveMovieFavoriteCommand}" CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0" Width="36" Height="36" Padding="0"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="4,0,0,0">
                                    <ui:FASymbolIcon Symbol="StarFilled" FontSize="16" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                    <DataTemplate DataType="vm:ClipListItemViewModel">
                        <Border Background="#22000000" CornerRadius="6" Margin="8,4" Padding="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="0"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Command="{Binding #RootControl.DataContext.SelectClipCommand}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <controls:ChannelLogoImage LogoUrl="{Binding CoverUrl}" Width="44" Height="44" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1"
                                        Command="{Binding #RootControl.DataContext.RemoveClipFavoriteCommand}" CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0" Width="36" Height="36" Padding="0"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="4,0,0,0">
                                    <ui:FASymbolIcon Symbol="StarFilled" FontSize="16" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
