<!-- Namespace is BitMagic.BennyBox.Views, not BitMagic.BennyBox.Android.Views - see LiveTvView.axaml's
     comment for why. Continue watching, then favourite channels, shows, films and videos, laid out like
     their own pages (MixedGridView): channels as compact rows, the rest as posters - part-watched ones
     with a progress bar. Tapping plays (continue watching, channels) or opens it on its own page; press
     and hold a poster to remove it. -->
<views:MixedGridView xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BitMagic.BennyBox.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:controls="using:BitMagic.BennyBox.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:views="using:BitMagic.BennyBox.Android.Views"
             x:Class="BitMagic.BennyBox.Views.FavoritesView"
             x:DataType="vm:FavoritesViewModel"
             x:Name="RootControl">
    <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Margin="16,12,16,0">
            <TextBlock Classes="headline" Text="Favourites" />
            <TextBlock Text="{Binding LoadError}" Foreground="OrangeRed" TextWrapping="Wrap" IsVisible="{Binding LoadError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLoading}">
            <ui:FAProgressRing IsActive="{Binding IsLoading}" Width="32" Height="32" />
        </StackPanel>
        <TextBlock Grid.Row="1" Margin="16" TextWrapping="Wrap" Opacity="0.7"
                   Text="Nothing here yet - press and hold a show or film (or tap a channel's star) to add it.">
            <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                    <Binding Path="!IsLoading" />
                    <Binding Path="HasNoFavorites" />
                </MultiBinding>
            </TextBlock.IsVisible>
        </TextBlock>

        <ScrollViewer Grid.Row="1" SizeChanged="OnListSizeChanged">
            <ItemsControl x:Name="FavouriteRows" Margin="12,0,12,12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="vm:CategoryHeaderRow">
                        <TextBlock Classes="title" Text="{Binding Name}" Margin="0,16,0,8" />
                    </DataTemplate>
                    <DataTemplate DataType="views:GridRow">
                        <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="{x:Static views:PosterGrid.Gap}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.DataTemplates>
                                <DataTemplate DataType="vm:WatchProgressItemViewModel">
                                    <Button Classes="poster" Width="{Binding #RootControl.TileWidth}"
                                            Click="OnPosterClick" ContextRequested="OnPosterContextRequested">
                                        <Button.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuItem Header="Remove from continue watching"
                                                          Command="{Binding #RootControl.DataContext.RemoveWatchProgressCommand}" CommandParameter="{Binding}" />
                                            </MenuFlyout>
                                        </Button.ContextFlyout>
                                        <views:PosterTile Width="{Binding #RootControl.TileWidth}" PosterHeight="{Binding #RootControl.PosterHeight}"
                                                          Title="{Binding Title}" ImageUrl="{Binding CoverUrl}" Progress="{Binding ProgressFraction}" />
                                    </Button>
                                </DataTemplate>

                                <DataTemplate DataType="vm:ChannelListItemViewModel">
                                    <Border Classes="card" Width="{Binding #RootControl.ColumnWidth}" Padding="8,4,4,4" MinHeight="64">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Button Grid.Column="0" Padding="0" Background="Transparent" BorderThickness="0"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Command="{Binding #RootControl.DataContext.SelectChannelCommand}" CommandParameter="{Binding Channel}">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <Border Width="48" Height="48" CornerRadius="8" ClipToBounds="True" VerticalAlignment="Center"
                                                            Background="{DynamicResource M3SurfaceContainerHighBrush}">
                                                        <controls:ChannelLogoImage LogoUrl="{Binding Channel.LogoUrl}" FallbackLogoUrl="{Binding FallbackLogoUrl}"
                                                                                   TmdbFallbackTitle="{Binding Name}" Margin="2" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Left" Text="⚠" Foreground="#FFB300" Margin="0,0,6,0"
                                                                       IsVisible="{Binding DidNotWork}" />
                                                            <TextBlock Text="{Binding Name}" FontSize="15" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding NowTitle}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis"
                                                                   IsVisible="{Binding HasNowTitle}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                            <Button Grid.Column="1" Classes="icon" ToolTip.Tip="Remove from favourites"
                                                    Command="{Binding #RootControl.DataContext.RemoveFavoriteCommand}" CommandParameter="{Binding}">
                                                <ui:FASymbolIcon Symbol="StarFilled" FontSize="18" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>

                                <DataTemplate DataType="vm:SeriesListItemViewModel">
                                    <Button Classes="poster" Width="{Binding #RootControl.TileWidth}"
                                            Click="OnPosterClick" ContextRequested="OnPosterContextRequested">
                                        <Button.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuItem Header="Remove from favourites"
                                                          Command="{Binding #RootControl.DataContext.RemoveSeriesFavoriteCommand}" CommandParameter="{Binding}" />
                                            </MenuFlyout>
                                        </Button.ContextFlyout>
                                        <views:PosterTile Width="{Binding #RootControl.TileWidth}" PosterHeight="{Binding #RootControl.PosterHeight}"
                                                          Title="{Binding Name}" ImageUrl="{Binding CoverUrl}" Opacity="{Binding ContentOpacity}" />
                                    </Button>
                                </DataTemplate>

                                <DataTemplate DataType="vm:MovieListItemViewModel">
                                    <Button Classes="poster" Width="{Binding #RootControl.TileWidth}"
                                            Click="OnPosterClick" ContextRequested="OnPosterContextRequested">
                                        <Button.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuItem Header="Remove from favourites"
                                                          Command="{Binding #RootControl.DataContext.RemoveMovieFavoriteCommand}" CommandParameter="{Binding}" />
                                            </MenuFlyout>
                                        </Button.ContextFlyout>
                                        <views:PosterTile Width="{Binding #RootControl.TileWidth}" PosterHeight="{Binding #RootControl.PosterHeight}"
                                                          Title="{Binding Name}" ImageUrl="{Binding CoverUrl}" DidNotWork="{Binding DidNotWork}"
                                                          Opacity="{Binding ContentOpacity}" />
                                    </Button>
                                </DataTemplate>

                                <DataTemplate DataType="vm:ClipListItemViewModel">
                                    <Button Classes="poster" Width="{Binding #RootControl.TileWidth}"
                                            Click="OnPosterClick" ContextRequested="OnPosterContextRequested">
                                        <Button.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuItem Header="Remove from favourites"
                                                          Command="{Binding #RootControl.DataContext.RemoveClipFavoriteCommand}" CommandParameter="{Binding}" />
                                            </MenuFlyout>
                                        </Button.ContextFlyout>
                                        <views:PosterTile Width="{Binding #RootControl.TileWidth}" PosterHeight="{Binding #RootControl.PosterHeight}"
                                                          Title="{Binding Name}" ImageUrl="{Binding CoverUrl}" DidNotWork="{Binding DidNotWork}"
                                                          Opacity="{Binding ContentOpacity}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.DataTemplates>
                        </ItemsControl>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</views:MixedGridView>
