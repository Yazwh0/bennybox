<!-- Namespace is BitMagic.BennyBox.Views, not BitMagic.BennyBox.Android.Views - see LiveTvView.axaml's
     comment for why. Same SeriesViewModel as desktop, laid out for a phone or tablet:
     - Browse: a search box, then Category / Source filter chips (the category chip opens a sheet with
       the categories as pictures and a search box), then the shows as a poster grid - 3 across on a
       phone, more as the screen gets wider (OnGridSizeChanged). Category headings stay full width
       between rows (GridRows), so long lists still virtualise. Press and hold a poster for "Add to
       favourites" / "Remove from favourites".
     - Show: a top bar with a back arrow and the name, the cover and details, then the episodes by
       season with watched / download buttons. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BitMagic.BennyBox.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:controls="using:BitMagic.BennyBox.Controls"
             xmlns:views="using:BitMagic.BennyBox.Android.Views"
             x:Class="BitMagic.BennyBox.Views.SeriesView"
             x:DataType="vm:SeriesViewModel"
             x:Name="RootControl">
    <Grid RowDefinitions="Auto,*">
        <!-- Search and filters. -->
        <!-- Search, then the Category / Source chips: underneath on a phone, beside the search box on a wider
             screen (FilterLayout). The chips take the search box's height so they line up either way. -->
        <Grid Grid.Row="0" x:Name="FilterPanel" ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" Margin="12,8,12,4" HorizontalAlignment="Left"
                    IsVisible="{Binding SelectedSeries, Converter={x:Static conv:ObjectConverters.IsNull}}">
            <TextBox x:Name="SearchBox" Grid.Column="0" Text="{Binding SearchText}" Watermark="Search shows" />
            <Panel Grid.Column="2" Width="48" Height="48" Margin="4,0,0,0">
                <ui:FAProgressRing IsActive="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Width="20" Height="20" />
                <Button Classes="icon" Command="{Binding RefreshCommand}" IsVisible="{Binding !IsLoading}" ToolTip.Tip="Refresh">
                    <ui:FASymbolIcon Symbol="Refresh" FontSize="20" />
                </Button>
            </Panel>
            <StackPanel x:Name="FilterChips" Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                <Button x:Name="CategoryChip" Classes="chip" Height="{Binding #SearchBox.Bounds.Height}" Click="OnCategoryChipClick" MaxWidth="260"
                        Classes.selected="{Binding SelectedCategory, Converter={x:Static views:BrowseConverters.IsFilterActive}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding SelectedCategory}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                        <ui:FASymbolIcon Symbol="ChevronDown" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="SourceChip" Classes="chip" Height="{Binding #SearchBox.Bounds.Height}" Click="OnSourceChipClick" MaxWidth="200"
                        Classes.selected="{Binding SelectedSource, Converter={x:Static views:BrowseConverters.IsFilterActive}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding SelectedSource}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                        <ui:FASymbolIcon Symbol="ChevronDown" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding LoadError}" Foreground="OrangeRed" TextWrapping="Wrap" IsVisible="{Binding HasLoadError}" />
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLoading}">
            <ui:FAProgressRing IsActive="{Binding IsLoading}" Width="32" Height="32" />
            <TextBlock Text="{Binding RefreshElapsedLabel, TargetNullValue='Loading shows...'}" Opacity="0.7" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="No shows yet - add a source and refresh it in Settings."
                   Margin="16" TextWrapping="Wrap" Opacity="0.7">
            <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                    <Binding Path="!IsLoading" />
                    <Binding Path="HasNoSeries" />
                </MultiBinding>
            </TextBlock.IsVisible>
        </TextBlock>
        <TextBlock Grid.Row="1" Text="No matches found." Margin="16" TextWrapping="Wrap" Opacity="0.7">
            <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                    <Binding Path="!IsLoading" />
                    <Binding Path="HasNoMatches" />
                </MultiBinding>
            </TextBlock.IsVisible>
        </TextBlock>

        <!-- The poster grid. -->
        <ScrollViewer Grid.Row="1" x:Name="GridScroller" SizeChanged="OnGridSizeChanged">
            <ScrollViewer.IsVisible>
                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                    <Binding Path="!IsLoading" />
                    <Binding Path="SelectedSeries" Converter="{x:Static conv:ObjectConverters.IsNull}" />
                </MultiBinding>
            </ScrollViewer.IsVisible>
            <ItemsControl x:Name="PosterRows" Margin="12,0,12,12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="vm:CategoryHeaderRow">
                        <TextBlock Classes="title" Text="{Binding Name}" Margin="0,16,0,8" />
                    </DataTemplate>
                    <DataTemplate DataType="views:GridRow">
                        <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="{x:Static views:PosterGrid.Gap}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.DataTemplates>
                                <DataTemplate DataType="vm:SeriesListItemViewModel">
                                    <Button Classes="poster" Width="{Binding #RootControl.TileWidth}"
                                            Click="OnPosterClick" ContextRequested="OnPosterContextRequested">
                                        <Button.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuItem Header="{Binding IsFavorite, Converter={x:Static views:BrowseConverters.FavouriteMenuText}}"
                                                          Command="{Binding #RootControl.DataContext.ToggleFavoriteCommand}" CommandParameter="{Binding}" />
                                            </MenuFlyout>
                                        </Button.ContextFlyout>
                                        <StackPanel Spacing="6" Opacity="{Binding ContentOpacity}">
                                            <Border Height="{Binding #RootControl.PosterHeight}" CornerRadius="10" ClipToBounds="True"
                                                    Background="{DynamicResource M3SurfaceContainerHighBrush}">
                                                <Panel>
                                                    <TextBlock Text="{Binding Name, Converter={x:Static views:SimpleModeConverters.Initials}}"
                                                               FontSize="28" FontWeight="Bold" Opacity="0.6"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <controls:ChannelLogoImage LogoUrl="{Binding CoverUrl}" Stretch="UniformToFill" />
                                                    <Border IsVisible="{Binding IsFavorite}" Width="28" Height="28" CornerRadius="14" Margin="6"
                                                            Background="#B3000000" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                        <ui:FASymbolIcon Symbol="StarFilled" FontSize="14" Foreground="#FFCA28" />
                                                    </Border>
                                                </Panel>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="13" TextWrapping="Wrap" MaxLines="2" Height="36"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.DataTemplates>
                        </ItemsControl>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </ScrollViewer>

        <!-- One show. -->
        <Grid Grid.Row="0" Grid.RowSpan="2" RowDefinitions="Auto,*"
              IsVisible="{Binding SelectedSeries, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="4,4,12,0" MinHeight="56">
                <Button Classes="icon" Command="{Binding BackToListCommand}" ToolTip.Tip="Back to shows">
                    <ui:FASymbolIcon Symbol="Back" FontSize="20" />
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding SelectedSeries.Name}" FontSize="20" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" />
            </Grid>
            <ScrollViewer Grid.Row="1">
                <StackPanel Margin="12,4,12,12">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Width="120" Height="180" CornerRadius="10" ClipToBounds="True" VerticalAlignment="Top"
                                Background="{DynamicResource M3SurfaceContainerHighBrush}">
                            <controls:ChannelLogoImage LogoUrl="{Binding SelectedSeries.CoverUrl}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="6" VerticalAlignment="Top">
                            <TextBlock Text="{Binding SelectedSeries.MetaLine, Converter={x:Static views:BrowseConverters.MetaLine}}"
                                       FontSize="13" Opacity="0.7" TextWrapping="Wrap" IsVisible="{Binding SelectedSeries.HasMetaLine}" />
                            <TextBlock Text="{Binding SelectedSeries.SourceName}" FontSize="13" Opacity="0.6" />
                            <TextBlock Text="{Binding SelectedSeries.Plot}" FontSize="14" TextWrapping="Wrap"
                                       MaxLines="5" TextTrimming="CharacterEllipsis" IsVisible="{Binding SelectedSeries.HasPlot}" />
                            <Button Classes="text" Content="More" HorizontalAlignment="Left" Margin="-12,0,0,0"
                                    IsVisible="{Binding SelectedSeries.HasPlot}">
                                <Button.Flyout>
                                    <Flyout Placement="Bottom">
                                        <ScrollViewer MaxHeight="400" MaxWidth="320">
                                            <TextBlock Text="{Binding SelectedSeries.Plot}" TextWrapping="Wrap" Margin="8" />
                                        </ScrollViewer>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Button Margin="0,12,0,0" HorizontalAlignment="Left" Command="{Binding DownloadAllEpisodesCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ui:FASymbolIcon Symbol="Download" FontSize="16" />
                            <TextBlock Text="Download all" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,32" IsVisible="{Binding IsLoadingEpisodes}">
                        <ui:FAProgressRing IsActive="{Binding IsLoadingEpisodes}" Width="32" Height="32" />
                        <TextBlock Text="Loading episodes..." Opacity="0.7" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Episodes}" IsVisible="{Binding !IsLoadingEpisodes}">
                        <ItemsControl.DataTemplates>
                            <DataTemplate DataType="vm:SeasonHeaderRow">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,4">
                                    <TextBlock Grid.Column="0" Classes="title" Text="{Binding Name}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="text"
                                            Command="{Binding #RootControl.DataContext.DownloadSeasonCommand}" CommandParameter="{Binding Season}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <ui:FASymbolIcon Symbol="Download" FontSize="14" />
                                            <TextBlock Text="Download season" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                            <DataTemplate DataType="vm:EpisodeListItemViewModel">
                                <Border Classes="card" Margin="0,4" Padding="12,8">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="0"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Command="{Binding #RootControl.DataContext.PlayEpisodeCommand}" CommandParameter="{Binding}">
                                            <StackPanel Opacity="{Binding ContentOpacity}" Spacing="2">
                                                <TextBlock Text="{Binding SeasonEpisodeLabel}" FontSize="12" Opacity="0.7" />
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Text="⚠" Foreground="#FFB300" Margin="0,0,6,0" IsVisible="{Binding DidNotWork}" />
                                                    <TextBlock Text="{Binding ShortTitle}" TextWrapping="Wrap" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Classes="icon" ToolTip.Tip="Watched"
                                                Command="{Binding #RootControl.DataContext.ToggleEpisodeWatchedCommand}" CommandParameter="{Binding}">
                                            <ui:FASymbolIcon Symbol="{Binding IsWatched, Converter={x:Static views:WatchedToSymbolConverter.Instance}}" FontSize="18" />
                                        </Button>
                                        <Button Grid.Column="2" Classes="icon" ToolTip.Tip="Download to this device"
                                                Command="{Binding #RootControl.DataContext.DownloadEpisodeCommand}" CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanDownload}" IsVisible="{Binding !IsFromDownloadsProfile}">
                                            <ui:FASymbolIcon Symbol="{Binding DownloadState, Converter={x:Static views:DownloadStateToSymbolConverter.Instance}}" FontSize="18" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.DataTemplates>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Category picker (see CategoryPickerSheet). -->
        <views:CategoryPickerSheet Grid.Row="0" Grid.RowSpan="2" x:Name="CategorySheet" FallbackPicture="Shows"
                                   Categories="{Binding FilteredCategories}" FilterText="{Binding CategoryFilterText}"
                                   Picked="OnCategoryPicked" />
    </Grid>
</UserControl>
