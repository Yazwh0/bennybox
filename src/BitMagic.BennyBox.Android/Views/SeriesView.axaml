<!-- Namespace is BitMagic.BennyBox.Views, not BitMagic.BennyBox.Android.Views - see LiveTvView.axaml's
     comment for why. Same list/detail-with-episodes structure as desktop's SeriesView.axaml, adapted
     to plain controls (no glass-*/source-badge classes - see App.axaml) and the row-card look already
     established in LiveTvView.axaml. The "Read full description" Button.Flyout is kept as-is - Flyouts
     open on the click event itself (not the bound Command), so this is real touch interaction rather
     than something the port needs to redesign, and FluentAvalonia's Flyout works the same cross-
     platform (see CLAUDE.md's debug-bridge notes on Flyouts needing real input either way). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BitMagic.BennyBox.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:controls="using:BitMagic.BennyBox.Controls"
             x:Class="BitMagic.BennyBox.Views.SeriesView"
             x:DataType="vm:SeriesViewModel"
             x:Name="RootControl">
    <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Spacing="6" Margin="8"
                    IsVisible="{Binding SelectedSeries, Converter={x:Static conv:ObjectConverters.IsNull}}">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox Grid.Column="0" Text="{Binding SearchText}" Watermark="Search series..." />
                <ui:FAProgressRing Grid.Column="1" IsActive="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Width="18" Height="18" Margin="6,0,0,0" />
                <Button Grid.Column="2" Content="&#8635;" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsLoading}" Margin="6,0,0,0" />
            </Grid>
            <TextBox Text="{Binding CategoryFilterText}" Watermark="Filter categories..." />
            <ComboBox ItemsSource="{Binding FilteredCategories}" SelectedItem="{Binding SelectedCategory}" HorizontalAlignment="Stretch" />
            <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" HorizontalAlignment="Stretch" />
            <TextBlock Text="{Binding LoadError}" Foreground="OrangeRed" TextWrapping="Wrap" IsVisible="{Binding HasLoadError}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLoading}">
            <ui:FAProgressRing IsActive="{Binding IsLoading}" Width="32" Height="32" />
            <TextBlock Text="{Binding RefreshElapsedLabel, TargetNullValue='Loading series...'}" Opacity="0.7" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="No series available yet - add an Xtream profile and refresh it in Settings."
                   Margin="16" TextWrapping="Wrap" Opacity="0.7">
            <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                    <Binding Path="!IsLoading" />
                    <Binding Path="HasNoSeries" />
                </MultiBinding>
            </TextBlock.IsVisible>
        </TextBlock>
        <TextBlock Grid.Row="1" Text="No matches found." Margin="16" TextWrapping="Wrap" Opacity="0.7">
            <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                    <Binding Path="!IsLoading" />
                    <Binding Path="HasNoMatches" />
                </MultiBinding>
            </TextBlock.IsVisible>
        </TextBlock>

        <ScrollViewer Grid.Row="1">
            <ScrollViewer.IsVisible>
                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                    <Binding Path="!IsLoading" />
                    <Binding Path="SelectedSeries" Converter="{x:Static conv:ObjectConverters.IsNull}" />
                </MultiBinding>
            </ScrollViewer.IsVisible>
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="vm:CategoryHeaderRow">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="8,12,8,4" />
                    </DataTemplate>
                    <DataTemplate DataType="vm:SeriesListItemViewModel">
                        <Border Background="#22000000" CornerRadius="6" Margin="8,4" Padding="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="0"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Command="{Binding #RootControl.DataContext.SelectSeriesCommand}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Opacity="{Binding ContentOpacity}">
                                        <controls:ChannelLogoImage LogoUrl="{Binding CoverUrl}" Width="44" Height="44" VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SourceName}" FontSize="11" Opacity="0.6" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Content="{Binding FavoriteIcon}"
                                        Command="{Binding #RootControl.DataContext.ToggleFavoriteCommand}" CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0" Width="36" Height="36" Padding="0"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="4,0,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="0" Grid.RowSpan="2" RowDefinitions="Auto,Auto,*"
              IsVisible="{Binding SelectedSeries, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
            <Button Grid.Row="0" Content="&#8592; Back to Series" Command="{Binding BackToListCommand}" Margin="8" HorizontalAlignment="Stretch" />
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="8,4">
                <controls:ChannelLogoImage Grid.Column="0" LogoUrl="{Binding SelectedSeries.CoverUrl}" Width="110" Height="165" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="6" VerticalAlignment="Top">
                    <TextBlock Text="{Binding SelectedSeries.Name}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap"
                               MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedSeries.Name}" />
                    <TextBlock Text="{Binding SelectedSeries.SourceName}" FontSize="11" Opacity="0.6" />
                    <TextBlock Text="{Binding SelectedSeries.MetaLine}" FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                               IsVisible="{Binding SelectedSeries.HasMetaLine}" />
                    <TextBlock Text="{Binding SelectedSeries.Plot}" FontSize="12" Opacity="0.85" TextWrapping="Wrap"
                               MaxLines="6" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding SelectedSeries.HasPlot}" ToolTip.Tip="{Binding SelectedSeries.Plot}" />
                    <Button Content="Read full description" FontSize="11" Padding="0" Margin="0,-2,0,0"
                            Background="Transparent" BorderThickness="0" HorizontalAlignment="Left"
                            IsVisible="{Binding SelectedSeries.HasPlot}">
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <ScrollViewer MaxHeight="400" MaxWidth="320">
                                    <TextBlock Text="{Binding SelectedSeries.Plot}" TextWrapping="Wrap" Margin="8" />
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Content="&#8595; Download All" FontSize="12" HorizontalAlignment="Left" Command="{Binding DownloadAllEpisodesCommand}" />
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="2" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLoadingEpisodes}">
                <ui:FAProgressRing IsActive="{Binding IsLoadingEpisodes}" Width="32" Height="32" />
                <TextBlock Text="Loading episodes..." Opacity="0.7" />
            </StackPanel>
            <ScrollViewer Grid.Row="2" IsVisible="{Binding !IsLoadingEpisodes}">
                <ItemsControl ItemsSource="{Binding Episodes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.DataTemplates>
                        <DataTemplate DataType="vm:SeasonHeaderRow">
                            <Grid ColumnDefinitions="*,Auto" Margin="8,12,8,4">
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="&#8595; Download Season" FontSize="11" Padding="8,4"
                                        Command="{Binding #RootControl.DataContext.DownloadSeasonCommand}" CommandParameter="{Binding Season}" />
                            </Grid>
                        </DataTemplate>
                        <DataTemplate DataType="vm:EpisodeListItemViewModel">
                            <Border Background="#22000000" CornerRadius="6" Margin="8,4" Padding="10">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="0"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Command="{Binding #RootControl.DataContext.PlayEpisodeCommand}" CommandParameter="{Binding}"
                                            ToolTip.Tip="{Binding LocalFilePath}">
                                        <StackPanel Opacity="{Binding ContentOpacity}">
                                            <TextBlock Text="{Binding SeasonEpisodeLabel}" FontSize="11" Opacity="0.7" />
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SourceName}" FontSize="11" Opacity="0.6" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Content="{Binding WatchedIcon}" ToolTip.Tip="Toggle watched"
                                            Command="{Binding #RootControl.DataContext.ToggleEpisodeWatchedCommand}" CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Width="36" Height="36" Padding="0"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="4,0,0,0" />
                                    <Button Grid.Column="2" Content="{Binding DownloadIcon}" ToolTip.Tip="Download to this device"
                                            Command="{Binding #RootControl.DataContext.DownloadEpisodeCommand}" CommandParameter="{Binding}"
                                            IsEnabled="{Binding CanDownload}" IsVisible="{Binding !IsFromDownloadsProfile}"
                                            Background="Transparent" BorderThickness="0" Width="36" Height="36" Padding="0"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="4,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
