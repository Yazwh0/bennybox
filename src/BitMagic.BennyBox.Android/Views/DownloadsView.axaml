<!-- Namespace is BitMagic.BennyBox.Views, not BitMagic.BennyBox.Android.Views - see LiveTvView.axaml's
     comment for why. Downloads as posters (MixedGridView), with a progress bar along the bottom while
     downloading and the status underneath. Tapping a finished one opens it on its own page; press and
     hold for Cancel / Retry / Delete. -->
<views:MixedGridView xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BitMagic.BennyBox.ViewModels"
             xmlns:views="using:BitMagic.BennyBox.Android.Views"
             x:Class="BitMagic.BennyBox.Views.DownloadsView"
             x:DataType="vm:DownloadsViewModel"
             x:Name="RootControl">
    <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Classes="headline" Text="Downloads" Margin="16,12,16,0" />

        <TextBlock Grid.Row="1" Text="Nothing downloaded yet - press and hold a film or video, or open a show, to download it."
                   Margin="16" TextWrapping="Wrap" Opacity="0.7" IsVisible="{Binding HasNoDownloads}" />

        <ScrollViewer Grid.Row="1" SizeChanged="OnListSizeChanged">
            <ItemsControl x:Name="DownloadRows" Margin="12,0,12,12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="vm:CategoryHeaderRow">
                        <TextBlock Classes="title" Text="{Binding Name}" Margin="0,16,0,8" />
                    </DataTemplate>
                    <DataTemplate DataType="views:GridRow">
                        <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="{x:Static views:PosterGrid.Gap}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.DataTemplates>
                                <DataTemplate DataType="vm:DownloadItemViewModel">
                                    <Button Classes="poster" Width="{Binding #RootControl.TileWidth}"
                                            Click="OnPosterClick" ContextRequested="OnPosterContextRequested">
                                        <Button.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuItem Header="Cancel" IsVisible="{Binding IsInProgress}"
                                                          Command="{Binding #RootControl.DataContext.CancelCommand}" CommandParameter="{Binding}" />
                                                <MenuItem Header="Try again" IsVisible="{Binding IsFailedOrCanceled}"
                                                          Command="{Binding #RootControl.DataContext.RetryCommand}" CommandParameter="{Binding}" />
                                                <MenuItem Header="Delete" IsVisible="{Binding !IsInProgress}"
                                                          Command="{Binding #RootControl.DataContext.DeleteCommand}" CommandParameter="{Binding}" />
                                            </MenuFlyout>
                                        </Button.ContextFlyout>
                                        <views:PosterTile Width="{Binding #RootControl.TileWidth}" PosterHeight="{Binding #RootControl.PosterHeight}"
                                                          Title="{Binding Title}" ImageUrl="{Binding CoverUrl}" Subtitle="{Binding StatusLabel}">
                                            <views:PosterTile.Progress>
                                                <MultiBinding Converter="{x:Static views:BrowseConverters.ProgressWhen}">
                                                    <Binding Path="IsInProgress" />
                                                    <Binding Path="ProgressFraction" />
                                                </MultiBinding>
                                            </views:PosterTile.Progress>
                                        </views:PosterTile>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.DataTemplates>
                        </ItemsControl>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</views:MixedGridView>
