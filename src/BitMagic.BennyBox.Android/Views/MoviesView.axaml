<!-- Namespace is BitMagic.BennyBox.Views, not BitMagic.BennyBox.Android.Views - see LiveTvView.axaml's
     comment for why. Same MoviesViewModel as desktop, laid out like SeriesView.axaml (see its comment):
     search and Category / Source chips, a poster grid that widens with the screen, press and hold a
     poster for favourites. A film opens a details page with Play, watched and download. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BitMagic.BennyBox.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:controls="using:BitMagic.BennyBox.Controls"
             xmlns:views="using:BitMagic.BennyBox.Android.Views"
             x:Class="BitMagic.BennyBox.Views.MoviesView"
             x:DataType="vm:MoviesViewModel"
             x:Name="RootControl">
    <Grid RowDefinitions="Auto,*">
        <!-- Search and filters. -->
        <StackPanel Grid.Row="0" x:Name="FilterPanel" Spacing="4" Margin="12,8,12,4" HorizontalAlignment="Left"
                    IsVisible="{Binding SelectedMovie, Converter={x:Static conv:ObjectConverters.IsNull}}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Text="{Binding SearchText}" Watermark="Search films" />
                <Panel Grid.Column="1" Width="48" Height="48" Margin="4,0,0,0">
                    <ui:FAProgressRing IsActive="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Width="20" Height="20" />
                    <Button Classes="icon" Command="{Binding RefreshCommand}" IsVisible="{Binding !IsLoading}" ToolTip.Tip="Refresh">
                        <ui:FASymbolIcon Symbol="Refresh" FontSize="20" />
                    </Button>
                </Panel>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="CategoryChip" Classes="chip" Click="OnCategoryChipClick" MaxWidth="260"
                        Classes.selected="{Binding SelectedCategory, Converter={x:Static views:BrowseConverters.IsFilterActive}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding SelectedCategory}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                        <ui:FASymbolIcon Symbol="ChevronDown" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="SourceChip" Classes="chip" Click="OnSourceChipClick" MaxWidth="200"
                        Classes.selected="{Binding SelectedSource, Converter={x:Static views:BrowseConverters.IsFilterActive}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding SelectedSource}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                        <ui:FASymbolIcon Symbol="ChevronDown" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="{Binding LoadError}" Foreground="OrangeRed" TextWrapping="Wrap" IsVisible="{Binding HasLoadError}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLoading}">
            <ui:FAProgressRing IsActive="{Binding IsLoading}" Width="32" Height="32" />
            <TextBlock Text="{Binding RefreshElapsedLabel, TargetNullValue='Loading films...'}" Opacity="0.7" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="No films yet - add a source and refresh it in Settings."
                   Margin="16" TextWrapping="Wrap" Opacity="0.7">
            <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                    <Binding Path="!IsLoading" />
                    <Binding Path="HasNoMovies" />
                </MultiBinding>
            </TextBlock.IsVisible>
        </TextBlock>
        <TextBlock Grid.Row="1" Text="No matches found." Margin="16" TextWrapping="Wrap" Opacity="0.7">
            <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                    <Binding Path="!IsLoading" />
                    <Binding Path="HasNoMatches" />
                </MultiBinding>
            </TextBlock.IsVisible>
        </TextBlock>

        <!-- The poster grid. -->
        <ScrollViewer Grid.Row="1" SizeChanged="OnGridSizeChanged">
            <ScrollViewer.IsVisible>
                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                    <Binding Path="!IsLoading" />
                    <Binding Path="SelectedMovie" Converter="{x:Static conv:ObjectConverters.IsNull}" />
                </MultiBinding>
            </ScrollViewer.IsVisible>
            <ItemsControl x:Name="PosterRows" Margin="12,0,12,12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="vm:CategoryHeaderRow">
                        <TextBlock Classes="title" Text="{Binding Name}" Margin="0,16,0,8" />
                    </DataTemplate>
                    <DataTemplate DataType="views:GridRow">
                        <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="{x:Static views:PosterGrid.Gap}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.DataTemplates>
                                <DataTemplate DataType="vm:MovieListItemViewModel">
                                    <Button Classes="poster" Width="{Binding #RootControl.TileWidth}"
                                            Click="OnPosterClick" ContextRequested="OnPosterContextRequested">
                                        <Button.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuItem Header="{Binding IsFavorite, Converter={x:Static views:BrowseConverters.FavouriteMenuText}}"
                                                          Command="{Binding #RootControl.DataContext.ToggleFavoriteCommand}" CommandParameter="{Binding}" />
                                                <MenuItem Header="{Binding IsWatched, Converter={x:Static views:BrowseConverters.WatchedMenuText}}"
                                                          Command="{Binding #RootControl.DataContext.ToggleWatchedCommand}" CommandParameter="{Binding}" />
                                            </MenuFlyout>
                                        </Button.ContextFlyout>
                                        <StackPanel Spacing="6" Opacity="{Binding ContentOpacity}">
                                            <Border Height="{Binding #RootControl.PosterHeight}" CornerRadius="10" ClipToBounds="True"
                                                    Background="{DynamicResource M3SurfaceContainerHighBrush}">
                                                <Panel>
                                                    <TextBlock Text="{Binding Name, Converter={x:Static views:SimpleModeConverters.Initials}}"
                                                               FontSize="28" FontWeight="Bold" Opacity="0.6"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <controls:ChannelLogoImage LogoUrl="{Binding CoverUrl}" Stretch="UniformToFill" />
                                                    <Border IsVisible="{Binding IsFavorite}" Width="28" Height="28" CornerRadius="14" Margin="6"
                                                            Background="#B3000000" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                        <ui:FASymbolIcon Symbol="StarFilled" FontSize="14" Foreground="#FFCA28" />
                                                    </Border>
                                                    <Border IsVisible="{Binding DidNotWork}" Width="28" Height="28" CornerRadius="14" Margin="6"
                                                            Background="#C62828" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                            ToolTip.Tip="Didn't work last time">
                                                        <TextBlock Text="!" FontWeight="Bold" Foreground="White"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </Panel>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="13" TextWrapping="Wrap" MaxLines="2" Height="36"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.DataTemplates>
                        </ItemsControl>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </ScrollViewer>

        <!-- One film. -->
        <Grid Grid.Row="0" Grid.RowSpan="2" RowDefinitions="Auto,*"
              IsVisible="{Binding SelectedMovie, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="4,4,12,0" MinHeight="56">
                <Button Classes="icon" Command="{Binding BackToListCommand}" ToolTip.Tip="Back to films">
                    <ui:FASymbolIcon Symbol="Back" FontSize="20" />
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding SelectedMovie.Name}" FontSize="20" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" />
            </Grid>
            <ScrollViewer Grid.Row="1">
                <StackPanel Margin="12,4,12,12" Spacing="12">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Width="120" Height="180" CornerRadius="10" ClipToBounds="True" VerticalAlignment="Top"
                                Background="{DynamicResource M3SurfaceContainerHighBrush}">
                            <controls:ChannelLogoImage LogoUrl="{Binding SelectedMovie.CoverUrl}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="6" VerticalAlignment="Top">
                            <TextBlock Text="{Binding SelectedMovie.MetaLine, Converter={x:Static views:BrowseConverters.MetaLine}}"
                                       FontSize="13" Opacity="0.7" TextWrapping="Wrap" IsVisible="{Binding SelectedMovie.HasMetaLine}" />
                            <TextBlock Text="{Binding SelectedMovie.SourceName}" FontSize="13" Opacity="0.6" />
                            <ui:FAProgressRing IsActive="{Binding SelectedMovie.IsLoadingDetails}" Width="20" Height="20"
                                               HorizontalAlignment="Left" IsVisible="{Binding SelectedMovie.IsLoadingDetails}" />
                            <TextBlock Text="⚠ Didn't work last time" Foreground="#FFB300" FontSize="13" IsVisible="{Binding SelectedMovie.DidNotWork}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="accent" Command="{Binding PlayMovieCommand}" CommandParameter="{Binding SelectedMovie}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ui:FASymbolIcon Symbol="PlayFilled" FontSize="16" />
                                <TextBlock Text="Play" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="icon" ToolTip.Tip="Watched"
                                Command="{Binding ToggleWatchedCommand}" CommandParameter="{Binding SelectedMovie}">
                            <ui:FASymbolIcon Symbol="{Binding SelectedMovie.IsWatched, Converter={x:Static views:WatchedToSymbolConverter.Instance}}" FontSize="20" />
                        </Button>
                        <Button Classes="icon" ToolTip.Tip="Favourite"
                                Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding SelectedMovie}">
                            <ui:FASymbolIcon Symbol="{Binding SelectedMovie.IsFavorite, Converter={x:Static views:FavoriteToSymbolConverter.Instance}}" FontSize="20" />
                        </Button>
                        <Button Classes="icon" ToolTip.Tip="Download to this device"
                                Command="{Binding DownloadCommand}" CommandParameter="{Binding SelectedMovie}"
                                IsEnabled="{Binding SelectedMovie.CanDownload}" IsVisible="{Binding !SelectedMovie.IsFromDownloadsProfile}">
                            <ui:FASymbolIcon Symbol="{Binding SelectedMovie.DownloadState, Converter={x:Static views:DownloadStateToSymbolConverter.Instance}}" FontSize="20" />
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding SelectedMovie.Plot}" FontSize="14" TextWrapping="Wrap" IsVisible="{Binding SelectedMovie.HasPlot}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Category picker (see CategoryPickerSheet). -->
        <views:CategoryPickerSheet Grid.Row="0" Grid.RowSpan="2" x:Name="CategorySheet" FallbackPicture="Films"
                                   Categories="{Binding FilteredCategories}" FilterText="{Binding CategoryFilterText}"
                                   Picked="OnCategoryPicked" />
    </Grid>
</UserControl>
