<!-- Simple picture mode (Settings > Simple picture mode): the whole app as big picture tiles, for someone
     who recognises pictures more easily than words (e.g. aphasia) and should be able to use it alone.
     - Home: Keep watching, then big tiles for Favourites, TV, Films, Shows and Videos, then "Normal mode".
     - TV/Films/Shows/Videos: category tiles, then a picture grid. One tap plays (shows resume their
       next unwatched episode). Nothing opens a text-heavy page, and there's no typing anywhere.
     - The same big Back button at the top of every screen except Home.
     - Press and hold any tile to hear its name read aloud (ReadAloud).
     - "Normal mode" is a visible tile you hold for 2 seconds (a bar fills while holding), so it's easy to
       find but not something a stray tap triggers.
     DataContext is the shell, for its page view models (LiveTv, Movies, Series, Clips, Favorites). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:controls="using:BitMagic.BennyBox.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:views="using:BitMagic.BennyBox.Android.Views"
             xmlns:vm="using:BitMagic.BennyBox.Android.ViewModels"
             x:Class="BitMagic.BennyBox.Android.Views.SimpleHomeView"
             x:DataType="vm:AndroidShellViewModel"
             x:Name="Root">
    <UserControl.Styles>
        <Style Selector="Button.simple-tile">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerBrush}" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
        <Style Selector="Button.simple-tile:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerBrush}" />
        </Style>
        <Style Selector="Button.simple-tile:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighestBrush}" />
        </Style>
        <Style Selector="TextBlock.tile-label">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxLines" Value="2" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <!-- Always two lines tall, so tiles in a row line up whatever their names. -->
            <Setter Property="Height" Value="54" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        </Style>
        <Style Selector="Border.picture-backing">
            <Setter Property="Background" Value="{DynamicResource M3PrimaryContainerBrush}" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="Border.picture-backing > TextBlock">
            <Setter Property="FontSize" Value="48" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnPrimaryContainerBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Fluent gives progress bars a 200px minimum width, wider than a phone tile. -->
        <Style Selector="ProgressBar">
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- Top bar: the big Back button (every screen but Home) and the screen's name. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="16,12,16,4" MinHeight="64">
            <Button x:Name="BackButton" Classes="accent" Click="OnBackClick" Holding="OnBackHolding"
                    MinHeight="64" Padding="24,8" CornerRadius="32" Margin="0,0,16,0" IsVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ui:FASymbolIcon Symbol="Back" FontSize="28" />
                    <TextBlock Text="Back" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ui:FASymbolIcon x:Name="TitleIcon" Symbol="Home" FontSize="30" />
                <TextBlock x:Name="TitleText" Text="Home" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <ListBox Grid.Row="1" x:Name="RowsList" Background="Transparent" SelectionMode="Single" Padding="16,0,16,24"
                 SizeChanged="OnListSizeChanged">
            <ListBox.DataTemplates>
                <DataTemplate DataType="views:SimpleHeader">
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="4,16,4,8" Background="Transparent">
                        <ui:FASymbolIcon Symbol="{Binding Icon}" FontSize="26" />
                        <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>

                <DataTemplate DataType="views:SimpleTileRow">
                    <ItemsControl ItemsSource="{Binding Tiles}" Margin="0,0,0,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.DataTemplates>
                            <DataTemplate DataType="views:SimpleTile">
                                <Button Classes="simple-tile" Width="{Binding #Root.TileWidth}" Click="OnTileClick" Holding="OnTileHolding">
                                    <StackPanel Spacing="8">
                                        <Panel Height="{Binding #Root.TileImageHeight}">
                                            <!-- Places and categories: a big icon on a coloured square. -->
                                            <Border Classes="picture-backing" IsVisible="{Binding HasIcon}">
                                                <ui:FASymbolIcon Symbol="{Binding Icon}" FontSize="64"
                                                                 Foreground="{DynamicResource M3OnPrimaryContainerBrush}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <!-- Items: the picture, or big initials when there isn't one. -->
                                            <Panel IsVisible="{Binding HasPicture}">
                                                <Border Classes="picture-backing" IsVisible="{Binding #Pic.Source, Converter={x:Static conv:ObjectConverters.IsNull}}">
                                                    <TextBlock Text="{Binding Title, Converter={x:Static views:SimpleModeConverters.Initials}}" />
                                                </Border>
                                                <controls:ChannelLogoImage x:Name="Pic" LogoUrl="{Binding ImageUrl}" FallbackLogoUrl="{Binding FallbackImageUrl}"
                                                                           TmdbFallbackTitle="{Binding TmdbFallbackTitle}" Stretch="Uniform" />
                                            </Panel>
                                        </Panel>
                                        <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="1" Height="6" CornerRadius="3"
                                                     IsVisible="{Binding HasProgress}" />
                                        <TextBlock Classes="tile-label" Text="{Binding Title}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>

                            <DataTemplate DataType="views:SimpleExitTile">
                                <Border Background="{DynamicResource M3SurfaceContainerHighBrush}" CornerRadius="20" Padding="12"
                                        Width="{Binding #Root.TileWidth}"
                                        PointerPressed="OnExitPressed" PointerReleased="OnExitReleased" PointerCaptureLost="OnExitCaptureLost">
                                    <StackPanel Spacing="8">
                                        <Border Height="{Binding #Root.TileImageHeight}" CornerRadius="12" Background="{DynamicResource M3SecondaryContainerBrush}">
                                            <StackPanel VerticalAlignment="Center" Spacing="8">
                                                <ui:FASymbolIcon Symbol="Settings" FontSize="56" HorizontalAlignment="Center"
                                                                 Foreground="{DynamicResource M3OnSecondaryContainerBrush}" />
                                                <TextBlock Text="Hold" FontSize="18" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource M3OnSecondaryContainerBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="1" Height="6" CornerRadius="3" />
                                        <TextBlock Classes="tile-label" Text="Normal mode" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.DataTemplates>
                    </ItemsControl>
                </DataTemplate>
            </ListBox.DataTemplates>
        </ListBox>

        <StackPanel Grid.Row="1" x:Name="EmptyMessage" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                    IsVisible="False">
            <ui:FASymbolIcon Symbol="Star" FontSize="64" HorizontalAlignment="Center" />
            <TextBlock Text="Nothing here yet" FontSize="24" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- While a show's episode list loads before playing its next episode. -->
        <Border Grid.Row="0" Grid.RowSpan="2" x:Name="BusyOverlay" Background="#66000000" IsVisible="False">
            <ui:FAProgressRing IsActive="{Binding #BusyOverlay.IsVisible}" Width="64" Height="64" />
        </Border>
    </Grid>
</UserControl>
