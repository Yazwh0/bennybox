<!-- Simple picture mode (Settings > Simple picture mode): the whole app as big picture tiles, for someone
     who recognises pictures more easily than words (e.g. aphasia) and should be able to use it alone.
     - Home: Keep watching, then the favourite channels, shows, films and videos as pictures, then big
       tiles for TV, Films, Shows and Videos to browse everything, then "Normal mode".
     - TV/Films/Shows/Videos: category tiles, then a picture grid. One tap plays (shows resume their
       next unwatched episode). Nothing opens a text-heavy page, and there's no typing anywhere.
     - Every place has one fixed picture and colour (SimplePictures), used everywhere it appears.
     - The same big Back button at the top of every screen except Home.
     - Press and hold any tile to hear its name read aloud (ReadAloud). Holding a channel, film, show or
       video also opens a panel with big Play / Favourite / Back buttons, so favourites can be added and
       removed without leaving simple mode.
     - "Normal mode" is a visible tile you hold for 2 seconds (a bar fills while holding), so it's easy to
       find but not something a stray tap triggers.
     DataContext is the shell, for its page view models (LiveTv, Movies, Series, Clips, Favorites). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:controls="using:BitMagic.BennyBox.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:views="using:BitMagic.BennyBox.Android.Views"
             xmlns:vm="using:BitMagic.BennyBox.Android.ViewModels"
             x:Class="BitMagic.BennyBox.Android.Views.SimpleHomeView"
             x:DataType="vm:AndroidShellViewModel"
             x:Name="Root">
    <UserControl.Styles>
        <Style Selector="Button.simple-tile">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerBrush}" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
        <Style Selector="Button.simple-tile:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerBrush}" />
        </Style>
        <Style Selector="Button.simple-tile:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighestBrush}" />
        </Style>
        <Style Selector="TextBlock.tile-label">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxLines" Value="2" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <!-- Always two lines tall, so tiles in a row line up whatever their names. -->
            <Setter Property="Height" Value="54" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        </Style>
        <Style Selector="Border.picture-backing">
            <Setter Property="Background" Value="{DynamicResource M3PrimaryContainerBrush}" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="Border.picture-backing > TextBlock">
            <Setter Property="FontSize" Value="48" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource M3OnPrimaryContainerBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.panel-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Padding" Value="4,12" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.panel-button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.panel-button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighestBrush}" />
        </Style>
        <!-- Fluent gives progress bars a 200px minimum width, wider than a phone tile. -->
        <Style Selector="ProgressBar">
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- Top bar: the big Back button (every screen but Home) and the screen's name. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="16,12,16,4" MinHeight="64">
            <Button x:Name="BackButton" Classes="accent" Click="OnBackClick" Holding="OnBackHolding"
                    MinHeight="64" Padding="24,8" CornerRadius="32" Margin="0,0,16,0" IsVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <views:SimplePictureIcon Picture="Back" Backed="False" Width="30" Height="30" />
                    <TextBlock Text="Back" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Grid Grid.Column="1" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                <views:SimplePictureIcon x:Name="TitleIcon" Picture="Home" Width="44" Height="44" Margin="0,0,12,0" />
                <TextBlock Grid.Column="1" x:Name="TitleText" Text="Home" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Grid>

        <ListBox Grid.Row="1" x:Name="RowsList" Background="Transparent" SelectionMode="Single" Padding="16,0,16,24"
                 SizeChanged="OnListSizeChanged">
            <ListBox.DataTemplates>
                <DataTemplate DataType="views:SimpleHeader">
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="4,16,4,8" Background="Transparent">
                        <views:SimplePictureIcon Picture="{Binding Icon}" Width="40" Height="40" CornerRadius="8" />
                        <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>

                <!-- A show's big "Play next" button, a whole row wide. -->
                <DataTemplate DataType="views:SimplePlayNextTile">
                    <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,8,0,8"
                            Padding="20,16" CornerRadius="24" MinHeight="112" Click="OnPlayNextClick" Holding="OnPlayNextHolding">
                        <Grid ColumnDefinitions="Auto,*">
                            <views:SimplePictureIcon Picture="Play" Width="72" Height="72" CornerRadius="36" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding Label}" FontSize="28" FontWeight="Bold" />
                                <TextBlock Text="{Binding Detail}" FontSize="20" />
                                <TextBlock Text="{Binding EpisodeTitle}" FontSize="18" TextTrimming="CharacterEllipsis" Opacity="0.85" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </DataTemplate>

                <!-- A channel's big "Watch now" button, a whole row wide: the same Play picture as Play next. -->
                <DataTemplate DataType="views:SimpleWatchNowTile">
                    <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,8,0,8"
                            Padding="20,16" CornerRadius="24" MinHeight="112" Click="OnWatchNowClick" Holding="OnWatchNowHolding">
                        <Grid ColumnDefinitions="Auto,*">
                            <views:SimplePictureIcon Picture="Play" Width="72" Height="72" CornerRadius="36" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Watch now" FontSize="28" FontWeight="Bold" />
                                <TextBlock Text="{Binding NowTitle}" FontSize="20" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasNowTitle}" />
                                <ProgressBar Value="{Binding Progress}" Maximum="1" IsVisible="{Binding HasProgress}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </DataTemplate>

                <DataTemplate DataType="views:SimpleTileRow">
                    <ItemsControl ItemsSource="{Binding Tiles}" Margin="0,0,0,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.DataTemplates>
                            <DataTemplate DataType="views:SimpleTile">
                                <Button Classes="simple-tile" Width="{Binding #Root.TileWidth}" Click="OnTileClick" Holding="OnTileHolding">
                                    <StackPanel Spacing="8">
                                        <Panel Height="{Binding #Root.TileImageHeight}">
                                            <!-- Places and categories: the place's own picture and colour. -->
                                            <views:SimplePictureIcon Picture="{Binding Icon, TargetNullValue=Home}" CornerRadius="12" IsVisible="{Binding HasIcon}" />
                                            <!-- Items: the picture, or big initials when there isn't one. -->
                                            <Panel IsVisible="{Binding HasPicture}">
                                                <Panel Opacity="{Binding PictureOpacity}">
                                                    <Border Classes="picture-backing" IsVisible="{Binding #Pic.Source, Converter={x:Static conv:ObjectConverters.IsNull}}">
                                                        <TextBlock Text="{Binding Placeholder}" />
                                                    </Border>
                                                    <controls:ChannelLogoImage x:Name="Pic" LogoUrl="{Binding ImageUrl}" FallbackLogoUrl="{Binding FallbackImageUrl}"
                                                                               TmdbFallbackTitle="{Binding TmdbFallbackTitle}" Stretch="Uniform" />
                                                </Panel>
                                                <!-- Watched episode: a green tick. -->
                                                <views:SimplePictureIcon Picture="Watched" IsVisible="{Binding IsWatched}"
                                                                         Width="44" Height="44" CornerRadius="22"
                                                                         HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                <!-- Didn't work last time: a big red "no" sign over the greyed picture. -->
                                                <views:SimplePictureIcon Picture="NotWorking" IsVisible="{Binding DidNotWork}"
                                                                         Width="64" Height="64" CornerRadius="32"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Panel>
                                            <!-- Categories without a keyword picture: the first few pictures inside. -->
                                            <Border IsVisible="{Binding HasCollage}" CornerRadius="12" ClipToBounds="True"
                                                    Background="{DynamicResource M3SurfaceContainerHighestBrush}">
                                                <ItemsControl ItemsSource="{Binding Collage}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="2" Rows="2" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="views:SimpleImage">
                                                            <controls:ChannelLogoImage Margin="2" LogoUrl="{Binding Url}" FallbackLogoUrl="{Binding FallbackUrl}"
                                                                                       TmdbFallbackTitle="{Binding TmdbFallbackTitle}" Stretch="Uniform" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                            <!-- A favourite: a yellow star, on pictures and category tiles alike. -->
                                            <views:SimplePictureIcon Picture="Favourite" IsVisible="{Binding IsFavourite}"
                                                                     Width="36" Height="36" CornerRadius="18" Margin="0,4,4,0"
                                                                     HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            <!-- What kind of thing it is, in its place's picture and colour. -->
                                            <views:SimplePictureIcon Picture="{Binding Badge, TargetNullValue=Home}" IsVisible="{Binding HasBadge}"
                                                                     Width="36" Height="36" CornerRadius="8"
                                                                     HorizontalAlignment="Left" VerticalAlignment="Top" />
                                        </Panel>
                                        <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="1" Height="6" CornerRadius="3"
                                                     IsVisible="{Binding HasProgress}" />
                                        <TextBlock Classes="tile-label" Text="{Binding Title}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>

                            <DataTemplate DataType="views:SimpleExitTile">
                                <Border Background="{DynamicResource M3SurfaceContainerHighBrush}" CornerRadius="20" Padding="12"
                                        Width="{Binding #Root.TileWidth}"
                                        PointerPressed="OnExitPressed" PointerReleased="OnExitReleased" PointerCaptureLost="OnExitCaptureLost">
                                    <StackPanel Spacing="8">
                                        <Border Height="{Binding #Root.TileImageHeight}" CornerRadius="12" Background="{DynamicResource M3SecondaryContainerBrush}">
                                            <StackPanel VerticalAlignment="Center" Spacing="8">
                                                <views:SimplePictureIcon Picture="Settings" Backed="False" Width="56" Height="56" HorizontalAlignment="Center"
                                                                         Foreground="{DynamicResource M3OnSecondaryContainerBrush}" />
                                                <TextBlock Text="Hold" FontSize="18" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource M3OnSecondaryContainerBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="1" Height="6" CornerRadius="3" />
                                        <TextBlock Classes="tile-label" Text="Normal mode" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.DataTemplates>
                    </ItemsControl>
                </DataTemplate>
            </ListBox.DataTemplates>
        </ListBox>

        <StackPanel Grid.Row="1" x:Name="EmptyMessage" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                    IsVisible="False">
            <views:SimplePictureIcon Picture="NotFavourite" Width="72" Height="72" HorizontalAlignment="Center" />
            <TextBlock Text="Nothing here yet" FontSize="24" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Held tile: its picture and name, with big Play / Favourite / Back buttons. Tapping outside
             the card also closes it. -->
        <Border Grid.Row="0" Grid.RowSpan="2" x:Name="ItemPanel" Background="#99000000" IsVisible="False"
                PointerPressed="OnItemPanelBackgroundPressed">
            <Border x:Name="ItemCard" Background="{DynamicResource M3SurfaceContainerHighBrush}" CornerRadius="28" Padding="20"
                    Margin="16" MaxWidth="480" VerticalAlignment="Center" x:DataType="views:SimpleTile">
                <StackPanel Spacing="16">
                    <Panel Height="180">
                        <!-- A category: its own picture and colour. -->
                        <views:SimplePictureIcon Picture="{Binding PanelPicture, TargetNullValue=Home}" IsVisible="{Binding HasPanelPicture}"
                                                 Width="180" Height="180" CornerRadius="20" HorizontalAlignment="Center" />
                        <Panel IsVisible="{Binding !HasPanelPicture}">
                        <Border Classes="picture-backing" IsVisible="{Binding #PanelPic.Source, Converter={x:Static conv:ObjectConverters.IsNull}}">
                            <TextBlock Text="{Binding Title, Converter={x:Static views:SimpleModeConverters.Initials}}" />
                        </Border>
                        <controls:ChannelLogoImage x:Name="PanelPic" LogoUrl="{Binding ImageUrl}" FallbackLogoUrl="{Binding FallbackImageUrl}"
                                                   TmdbFallbackTitle="{Binding TmdbFallbackTitle}" Stretch="Uniform" />
                        </Panel>
                        <views:SimplePictureIcon Picture="{Binding Badge, TargetNullValue=Home}" IsVisible="{Binding HasBadge}"
                                                 Width="44" Height="44" CornerRadius="10"
                                                 HorizontalAlignment="Left" VerticalAlignment="Top" />
                    </Panel>
                    <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" TextAlignment="Center"
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <UniformGrid Columns="3">
                        <Button Classes="panel-button" Tag="{Binding PrimaryLabel}" Click="OnPanelPlayClick" Holding="OnPanelButtonHolding">
                            <StackPanel Spacing="8">
                                <views:SimplePictureIcon Picture="Play" Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding PrimaryLabel}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="panel-button" Click="OnPanelFavouriteClick" Holding="OnPanelButtonHolding"
                                Tag="{Binding IsFavourite, Converter={x:Static views:SimpleModeConverters.FavouriteLabel}}">
                            <StackPanel Spacing="8">
                                <views:SimplePictureIcon Picture="{Binding IsFavourite, Converter={x:Static views:SimpleModeConverters.FavouritePicture}}"
                                                         Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding IsFavourite, Converter={x:Static views:SimpleModeConverters.FavouriteLabel}}"
                                           FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="panel-button" Tag="Back" Click="OnPanelBackClick" Holding="OnPanelButtonHolding">
                            <StackPanel Spacing="8">
                                <views:SimplePictureIcon Picture="Back" Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center" />
                                <TextBlock Text="Back" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Border>

        <!-- While a show's episode list loads before playing its next episode. -->
        <Border Grid.Row="0" Grid.RowSpan="2" x:Name="BusyOverlay" Background="#66000000" IsVisible="False">
            <ui:FAProgressRing IsActive="{Binding #BusyOverlay.IsVisible}" Width="64" Height="64" />
        </Border>
    </Grid>
</UserControl>
