<!-- Namespace is BitMagic.BennyBox.Views, not BitMagic.BennyBox.Android.Views - see LiveTvView.axaml's
     comment for why (ViewLocator resolves by string-substituting the ViewModel's own namespace).

     Trimmed down from desktop's SettingsView.axaml: no "Background opacity" card (that drives
     MainWindow's Window.Background acrylic brush, a desktop-window concept AndroidShellView - a plain
     UserControl - has no equivalent of) and no "Remote control" card (AndroidShellViewModel doesn't
     compose RemoteControlViewModel - see its own comment). Everything else maps directly since it's
     all just ISettingsStore-backed values with no desktop-only assumptions. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BitMagic.BennyBox.ViewModels"
             xmlns:models="using:BitMagic.BennyBox.Core.Models"
             xmlns:converters="using:Avalonia.Data.Converters"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="BitMagic.BennyBox.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             x:Name="RootControl">
    <!-- The busy overlay sits over the whole page: profile imports can take a minute or more, and the
         status line in the Profiles card is easy to miss further down the scroll. -->
    <Grid>
        <ScrollViewer>
            <StackPanel Margin="8" Spacing="10">
                <TextBlock Text="Settings" Classes="headline" Margin="8,8,8,0" />

                <Border Classes="card" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Appearance" Classes="title" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Theme" Opacity="0.7" FontSize="12" />
                            <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <!-- See SimpleHomeView. Leaving it again is a 2-second hold on its "Normal mode" tile. -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Simple picture mode" />
                                <TextBlock Text="Everything as big pictures, with no menus or typing. Hold any picture to hear its name or make it a favourite. To leave, hold the Normal mode tile at the bottom of its home screen for 2 seconds."
                                           Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsSimpleMode}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- See PriorityOrder. LostFocus so the lists reload once when editing finishes. -->
                <Border Classes="card" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Ordering" Classes="title" />
                        <TextBlock Text="Categories and channels whose names start with these come first, in this order. Separate with commas."
                                   Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Show first" Opacity="0.7" FontSize="12" />
                            <TextBox Text="{Binding PriorityPrefixes, UpdateSourceTrigger=LostFocus}" Watermark="e.g. UK, US" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Updates" Classes="title" />
                        <TextBlock Text="{Binding CurrentVersion, StringFormat='Current version: {0}'}" Opacity="0.7" FontSize="12" />
                        <!-- A Google Play install gets its updates from Play (see PlayAwareUpdateCheckService), so the
                             GitHub check is swapped for a note; a sideloaded APK keeps it. -->
                        <TextBlock Text="Updates are installed by Google Play." Opacity="0.7" FontSize="12" IsVisible="{Binding !IsUpdateCheckAvailable}" />
                        <!-- M3 settings toggles are a switch at the end of the row, not a checkbox. -->
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsUpdateCheckAvailable}">
                            <TextBlock Text="Check for updates automatically" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding CheckForUpdatesAutomatically}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsUpdateCheckAvailable}">
                            <Button Content="Check now" Command="{Binding CheckForUpdatesNowCommand}" IsEnabled="{Binding !IsCheckingForUpdates}" />
                            <ui:FAProgressRing IsActive="{Binding IsCheckingForUpdates}" Width="18" Height="18" IsVisible="{Binding IsCheckingForUpdates}" />
                            <TextBlock Text="{Binding UpdateCheckStatus}" IsVisible="{Binding HasUpdateCheckStatus}" VerticalAlignment="Center" Opacity="0.7" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Playback controls" Classes="title" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Skip interval (seconds)" Opacity="0.7" FontSize="12" />
                            <NumericUpDown Value="{Binding SkipIntervalSeconds}" Minimum="5" Maximum="300" Increment="5" FormatString="0" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Playback recovery" Classes="title" />
                        <TextBlock Text="How quickly a frozen/dropped stream is detected and offered a retry."
                                   Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Connect timeout (seconds)" Opacity="0.7" FontSize="12" />
                            <NumericUpDown Value="{Binding LoadTimeoutSeconds}" Minimum="3" Maximum="120" Increment="1" FormatString="0" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Stall detection (seconds)" Opacity="0.7" FontSize="12" />
                            <NumericUpDown Value="{Binding StallThresholdSeconds}" Minimum="2" Maximum="60" Increment="1" FormatString="0" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Pause reconnect after (seconds)" Opacity="0.7" FontSize="12" />
                            <NumericUpDown Value="{Binding PauseReconnectThresholdSeconds}" Minimum="5" Maximum="600" Increment="5" FormatString="0" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Track defaults" Classes="title" />
                        <TextBlock Text="Matched loosely against whatever name the stream/episode reports for its tracks. Leave blank to use the stream's own default; subtitles default to off unless set here."
                                   Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Preferred audio" Opacity="0.7" FontSize="12" />
                            <ComboBox ItemsSource="{Binding CommonLanguages}" SelectedItem="{Binding PreferredAudioLanguage}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Preferred subtitles" Opacity="0.7" FontSize="12" />
                            <ComboBox ItemsSource="{Binding CommonLanguages}" SelectedItem="{Binding PreferredSubtitleLanguage}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Same "disappear entirely rather than show an empty notice" rule as desktop's SettingsView. -->
                <Border Classes="card" Padding="16" IsVisible="{Binding ShowMetadataEnrichmentCard}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Metadata enrichment" Classes="title" />
                        <TextBlock Text="Fills in a synopsis, genre, and poster for Local Folder/SFTP movies and shows with no local NFO/poster, using themoviedb.org. Leave blank to skip. Get a free API key at themoviedb.org (Settings &#8594; API)."
                                   Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="TMDb API Key" Opacity="0.7" FontSize="12" />
                            <TextBox Text="{Binding TmdbApiKey}" Watermark="Not set" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Downloads" Classes="title" />
                        <TextBlock Text="Where movies, episodes, and clips land when downloaded for offline/faster playback."
                                   Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                        <TextBox Text="{Binding DownloadsFolderPath}" IsReadOnly="True" />
                        <Button Content="Change location..." Click="OnChangeDownloadsLocationClick" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding DownloadsDiskUsageLabel}" Opacity="0.7" FontSize="12" VerticalAlignment="Center" />
                            <Button Content="Clear all downloads" Command="{Binding ClearAllDownloadsCommand}" IsEnabled="{Binding !IsBusy}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Profiles" Classes="title" />
                        <!-- Scan reads a code from desktop's "Set up phone..."/row "QR" buttons or another phone's "Share
                             setup..." (settings, favourites, optionally sources); Paste takes the
                             same code as text (desktop's "Copy as text"), for when the camera scanner isn't available. -->
                        <WrapPanel ItemSpacing="8" LineSpacing="8">
                            <Button Classes="accent" Content="Scan QR code" Click="OnScanSetupQrClick" IsEnabled="{Binding !IsBusy}" />
                            <Button Content="Paste code" Click="OnPasteSetupCodeClick" IsEnabled="{Binding !IsBusy}" />
                            <Button Content="Add Profile" Click="OnAddProfileClick" IsEnabled="{Binding !IsBusy}" />
                            <Button Content="Share setup..." Click="OnShareSetupClick" IsEnabled="{Binding !IsBusy}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ProfileSource">
                                    <Border BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <StackPanel Spacing="6">
                                            <!-- Dimmed when disabled rather than given an extra line - see desktop SettingsView. -->
                                            <StackPanel.Styles>
                                                <Style Selector="StackPanel.profile-disabled">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </Style>
                                            </StackPanel.Styles>
                                            <StackPanel Classes.profile-disabled="{Binding !IsEnabled}">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding SourceType}" Opacity="0.7" FontSize="12" />
                                                <TextBlock Opacity="0.7" FontSize="12"
                                                           IsVisible="{Binding XtreamStatus, Converter={x:Static converters:ObjectConverters.IsNotNull}}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} · expires {1:yyyy-MM-dd} · {2} connections">
                                                            <Binding Path="XtreamStatus" />
                                                            <Binding Path="XtreamExpiryUtc" />
                                                            <Binding Path="XtreamMaxConnections" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="0" Margin="-12,0,0,0">
                                                    <Button Classes="text" Content="Edit" Click="OnEditProfileClick" CommandParameter="{Binding}"
                                                            IsEnabled="{Binding #RootControl.DataContext.IsBusy, Converter={x:Static converters:BoolConverters.Not}}" />
                                                    <Button Classes="text" Content="Refresh" Command="{Binding #RootControl.DataContext.RefreshProfileCommand}" CommandParameter="{Binding}"
                                                            IsEnabled="{Binding #RootControl.DataContext.IsBusy, Converter={x:Static converters:BoolConverters.Not}}" />
                                                    <Button Classes="text" Content="Delete" Command="{Binding #RootControl.DataContext.DeleteProfileCommand}" CommandParameter="{Binding}"
                                                            IsEnabled="{Binding #RootControl.DataContext.IsBusy, Converter={x:Static converters:BoolConverters.Not}}" />
                                                </StackPanel>
                                                <!-- M3 switch for enabled/disabled. OneWay: tapping runs the command,
                                                     which flips IsEnabled and reloads the list. -->
                                                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                              IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                              Command="{Binding #RootControl.DataContext.ToggleProfileEnabledCommand}" CommandParameter="{Binding}"
                                                              IsEnabled="{Binding #RootControl.DataContext.IsBusy, Converter={x:Static converters:BoolConverters.Not}}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <!-- TMDb's API terms require this attribution somewhere in the app; see also PRIVACY.md. -->
                <Border Classes="card" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="About" Classes="title" />
                        <TextBlock Text="Benny Box plays sources you add yourself; it doesn't include any channels or content. Your profiles and passwords stay on this device."
                                   Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Text="This product uses the TMDb API but is not endorsed or certified by TMDb."
                                   Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Text="Privacy policy: bitmagic.org/bennybox/privacy"
                                   Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Background="#88000000" IsVisible="{Binding IsBusy}">
            <Border Background="{DynamicResource M3SurfaceContainerHighBrush}" CornerRadius="28" Padding="24" Margin="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                <StackPanel Spacing="12">
                    <ui:FAProgressRing IsActive="{Binding IsBusy}" Width="36" Height="36" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
