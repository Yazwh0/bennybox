<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BitMagic.BennyBox.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:controls="using:BitMagic.BennyBox.Controls"
             x:Class="BitMagic.BennyBox.Views.DownloadsView"
             x:DataType="vm:DownloadsViewModel"
             x:Name="RootControl">
    <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Spacing="6" Margin="8,8,8,4">
            <TextBlock Text="Downloads" FontWeight="Bold" FontSize="16" Foreground="{StaticResource GlassTextBrush}" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Nothing downloaded yet - look for the download button on a movie, episode, or clip."
                   Margin="16" TextWrapping="Wrap" Opacity="0.7" IsVisible="{Binding HasNoDownloads}" />

        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="vm:CategoryHeaderRow">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="8,8,8,4" Foreground="{StaticResource GlassTextBrush}" />
                    </DataTemplate>
                    <DataTemplate DataType="vm:DownloadItemViewModel">
                        <Border Classes="glass-card" Margin="8,4" Padding="10">
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                <controls:ChannelLogoImage Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                                            LogoUrl="{Binding CoverUrl}"
                                                            Width="44" Height="44" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" Foreground="{StaticResource GlassTextBrush}"
                                           MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StatusLabel}" FontSize="11" Opacity="0.75" Margin="0,4,0,0" />
                                <ProgressBar Grid.Row="1" Grid.Column="1" Height="4" Margin="0,2,80,0" VerticalAlignment="Bottom"
                                             Minimum="0" Maximum="1" Value="{Binding ProgressFraction}"
                                             Background="{StaticResource GlassPanelBrush}" Foreground="{StaticResource AccentBrush}"
                                             IsVisible="{Binding IsInProgress}" />
                                <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Classes="glass-nav" Content="Cancel"
                                        Command="{Binding #RootControl.DataContext.CancelCommand}" CommandParameter="{Binding}"
                                        IsVisible="{Binding IsInProgress}" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Orientation="Horizontal" Spacing="4"
                                            IsVisible="{Binding !IsInProgress}" VerticalAlignment="Center">
                                    <!-- Same icon-only glass-nav row-button convention as Favorite/Watched/Download
                                         elsewhere (MoviesView/SeriesView/ClipsView), not text labels. Resumes from
                                         where the failed/canceled attempt left off for Xtream/Local sources - SFTP
                                         restarts cleanly from scratch instead (the SSH.NET version this app uses
                                         has no offset-based read support), see DownloadManager. -->
                                    <Button Classes="glass-nav" Content="&#8635;" ToolTip.Tip="Retry"
                                            Command="{Binding #RootControl.DataContext.RetryCommand}" CommandParameter="{Binding}"
                                            IsVisible="{Binding IsFailedOrCanceled}"
                                            MinWidth="28" Padding="6,0" />
                                    <Button Classes="glass-nav" Content="&#10007;" ToolTip.Tip="Delete"
                                            Command="{Binding #RootControl.DataContext.DeleteCommand}" CommandParameter="{Binding}"
                                            MinWidth="28" Padding="6,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
