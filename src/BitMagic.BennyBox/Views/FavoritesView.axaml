<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BitMagic.BennyBox.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:controls="using:BitMagic.BennyBox.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="BitMagic.BennyBox.Views.FavoritesView"
             x:DataType="vm:FavoritesViewModel"
             x:Name="RootControl">
    <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Text="Favorites" FontSize="20" Margin="8" Foreground="{StaticResource GlassTextBrush}" />
        <StackPanel Grid.Row="1" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsVisible="{Binding IsLoading}">
            <ui:FAProgressRing IsActive="{Binding IsLoading}" Width="32" Height="32" />
            <TextBlock Text="Loading favorites..." Opacity="0.7" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="No favorites yet - star a channel or series to add it here."
                   Margin="16" TextWrapping="Wrap" Opacity="0.7">
            <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                    <Binding Path="!IsLoading" />
                    <Binding Path="HasNoFavorites" />
                </MultiBinding>
            </TextBlock.IsVisible>
        </TextBlock>
        <ScrollViewer Grid.Row="1" IsVisible="{Binding !IsLoading}">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="vm:CategoryHeaderRow">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="8,8,8,4" Foreground="{StaticResource GlassTextBrush}" />
                    </DataTemplate>
                    <DataTemplate DataType="vm:WatchProgressItemViewModel">
                        <Border Classes="glass-card" Margin="8,4" Padding="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Button Classes="glass-ctrl flat" Grid.Column="0"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding #RootControl.DataContext.PlayWatchProgressCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <controls:ChannelLogoImage LogoUrl="{Binding CoverUrl}"
                                                                    Width="44" Height="44" VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Foreground="{StaticResource GlassTextBrush}" />
                                            <ProgressBar Value="{Binding ProgressFraction}" Minimum="0" Maximum="1"
                                                         Width="140" Height="4" HorizontalAlignment="Left" Foreground="{StaticResource AccentBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Classes="glass-nav flat" Grid.Column="1"
                                        Content="✕"
                                        Command="{Binding #RootControl.DataContext.RemoveWatchProgressCommand}"
                                        CommandParameter="{Binding}"
                                        VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Width="34" Height="34" Padding="0"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Margin="4,0,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                    <DataTemplate DataType="vm:ChannelListItemViewModel">
                        <Border Classes="glass-card" Margin="8,4" Padding="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Button Classes="glass-ctrl flat" Grid.Column="0"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding #RootControl.DataContext.SelectChannelCommand}"
                                        CommandParameter="{Binding Channel}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <controls:ChannelLogoImage LogoUrl="{Binding Channel.LogoUrl}"
                                                                    Width="44" Height="44" VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource GlassTextBrush}" />
                                            <TextBlock Text="{Binding NowTitle}"
                                                        FontSize="11" Foreground="{StaticResource GlassTextDimBrush}"
                                                        IsVisible="{Binding HasNowTitle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Classes="glass-nav flat" Grid.Column="1"
                                        Content="★"
                                        Command="{Binding #RootControl.DataContext.RemoveFavoriteCommand}"
                                        CommandParameter="{Binding}"
                                        VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Width="34" Height="34" Padding="0"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Margin="4,0,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                    <DataTemplate DataType="vm:SeriesListItemViewModel">
                        <Border Classes="glass-card" Margin="8,4" Padding="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Button Classes="glass-ctrl flat" Grid.Column="0"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding #RootControl.DataContext.SelectSeriesCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <controls:ChannelLogoImage LogoUrl="{Binding CoverUrl}"
                                                                    Width="44" Height="44" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource GlassTextBrush}" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="glass-nav flat" Grid.Column="1"
                                        Content="★"
                                        Command="{Binding #RootControl.DataContext.RemoveSeriesFavoriteCommand}"
                                        CommandParameter="{Binding}"
                                        VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Width="34" Height="34" Padding="0"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Margin="4,0,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                    <DataTemplate DataType="vm:MovieListItemViewModel">
                        <Border Classes="glass-card" Margin="8,4" Padding="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Button Classes="glass-ctrl flat" Grid.Column="0"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding #RootControl.DataContext.SelectMovieCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <controls:ChannelLogoImage LogoUrl="{Binding CoverUrl}"
                                                                    Width="44" Height="44" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource GlassTextBrush}" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="glass-nav flat" Grid.Column="1"
                                        Content="★"
                                        Command="{Binding #RootControl.DataContext.RemoveMovieFavoriteCommand}"
                                        CommandParameter="{Binding}"
                                        VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Width="34" Height="34" Padding="0"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Margin="4,0,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                    <DataTemplate DataType="vm:ClipListItemViewModel">
                        <Border Classes="glass-card" Margin="8,4" Padding="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Button Classes="glass-ctrl flat" Grid.Column="0"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding #RootControl.DataContext.SelectClipCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <controls:ChannelLogoImage LogoUrl="{Binding CoverUrl}"
                                                                    Width="44" Height="44" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource GlassTextBrush}" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="glass-nav flat" Grid.Column="1"
                                        Content="★"
                                        Command="{Binding #RootControl.DataContext.RemoveClipFavoriteCommand}"
                                        CommandParameter="{Binding}"
                                        VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Width="34" Height="34" Padding="0"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Margin="4,0,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
