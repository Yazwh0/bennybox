<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BitMagic.BennyBox.ViewModels"
             x:Class="BitMagic.BennyBox.Views.AddProfileView"
             x:DataType="vm:AddProfileViewModel">
    <StackPanel Spacing="12" Width="400">
        <StackPanel Spacing="4">
            <TextBlock Text="Name" />
            <TextBox Text="{Binding Name}" PlaceholderText="My IPTV Playlist" />
        </StackPanel>

        <!-- WrapPanel, not a horizontal StackPanel - four options no longer fit on one line within
             this dialog's fixed 400px width (the fourth one used to render past the dialog's right
             edge, off the visible window, rather than wrapping). WrapPanel has no built-in spacing
             property like StackPanel, so each RadioButton carries its own margin instead. -->
        <WrapPanel>
            <RadioButton Content="M3U Playlist" GroupName="SourceType" IsChecked="{Binding IsM3uSelected}" Margin="0,0,16,8" />
            <RadioButton Content="Xtream Codes" GroupName="SourceType" IsChecked="{Binding IsXtreamSelected}" Margin="0,0,16,8" />
            <RadioButton Content="Local Folder" GroupName="SourceType" IsChecked="{Binding IsLocalFolderSelected}" Margin="0,0,16,8" />
            <RadioButton Content="SFTP Site" GroupName="SourceType" IsChecked="{Binding IsSftpSelected}" Margin="0,0,16,8" />
            <RadioButton Content="Jellyfin" GroupName="SourceType" IsChecked="{Binding IsJellyfinSelected}" Margin="0,0,16,8" />
        </WrapPanel>

        <StackPanel Spacing="12" IsVisible="{Binding IsM3uSelected}">
            <StackPanel Spacing="4">
                <TextBlock Text="M3U Playlist URL" />
                <TextBox Text="{Binding M3uUrl}" PlaceholderText="https://example.com/playlist.m3u8" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="EPG (XMLTV) URL - optional" />
                <TextBox Text="{Binding EpgUrl}" PlaceholderText="https://example.com/epg.xml" />
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="12" IsVisible="{Binding IsXtreamSelected}">
            <StackPanel Spacing="4">
                <TextBlock Text="Server URL" />
                <TextBox Text="{Binding XtreamServerUrl}" PlaceholderText="https://example.com:8080" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="Username" />
                <TextBox Text="{Binding XtreamUsername}" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="Password" />
                <TextBox Text="{Binding XtreamPassword}" PasswordChar="●" />
            </StackPanel>
            <Button Content="Test Connection" Command="{Binding TestConnectionCommand}" IsEnabled="{Binding !IsTestingConnection}" />
            <TextBlock Text="{Binding TestResultMessage}"
                        TextWrapping="Wrap"
                        IsVisible="{Binding HasTestResult}" />
        </StackPanel>

        <StackPanel Spacing="12" IsVisible="{Binding IsJellyfinSelected}">
            <StackPanel Spacing="4">
                <TextBlock Text="Server URL" />
                <TextBox Text="{Binding JellyfinServerUrl}" PlaceholderText="http://192.168.1.10:8096" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="Username" />
                <TextBox Text="{Binding JellyfinUsername}" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="Password" />
                <TextBox Text="{Binding JellyfinPassword}" PasswordChar="●" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="API Key - optional, used instead of the password" />
                <TextBox Text="{Binding JellyfinApiKey}" PasswordChar="●" PlaceholderText="Dashboard → API Keys" />
            </StackPanel>
            <TextBlock Text="With an API key, the username just picks whose libraries to show (can be left blank if the server has one user)."
                        Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
            <Button Content="Connect &amp; Load Libraries" Command="{Binding TestConnectionCommand}" IsEnabled="{Binding !IsTestingConnection}" />
            <TextBlock Text="{Binding TestResultMessage}"
                        TextWrapping="Wrap"
                        IsVisible="{Binding HasTestResult}" />
            <StackPanel Spacing="6">
                <TextBlock Text="Libraries" />
                <TextBlock Text="Connect &amp; Load Libraries lists the server's libraries so you can choose where each one appears. Until then, each library goes where its Jellyfin type suggests (mixed-content libraries go to Clips). Live TV is imported automatically if the server has it."
                            IsVisible="{Binding !JellyfinLibraries.Count}"
                            Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding JellyfinLibraries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:JellyfinLibraryRowViewModel">
                            <Grid ColumnDefinitions="*,150" Margin="0,0,0,4">
                                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding TargetOptions}" SelectedItem="{Binding SelectedOption}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="12" IsVisible="{Binding IsLocalFolderSelected}">
            <TextBlock Text="Set a Movies folder, a TV Shows folder, a Clips folder, or some combination - each is optional on its own."
                        Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
            <StackPanel Spacing="4">
                <TextBlock Text="Movies Folder" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Text="{Binding LocalMoviesPath}" IsReadOnly="True" PlaceholderText="Not set" />
                    <Button Grid.Column="1" Content="Browse..." Click="OnBrowseMoviesFolderClick" Margin="6,0,0,0" />
                </Grid>
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="TV Shows Folder" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Text="{Binding LocalSeriesPath}" IsReadOnly="True" PlaceholderText="Not set" />
                    <Button Grid.Column="1" Content="Browse..." Click="OnBrowseSeriesFolderClick" Margin="6,0,0,0" />
                </Grid>
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="Clips Folder" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Text="{Binding LocalClipsPath}" IsReadOnly="True" PlaceholderText="Not set" />
                    <Button Grid.Column="1" Content="Browse..." Click="OnBrowseClipsFolderClick" Margin="6,0,0,0" />
                </Grid>
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="12" IsVisible="{Binding IsSftpSelected}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Host" />
                    <TextBox Text="{Binding SftpHost}" PlaceholderText="example.com" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4" Width="70">
                    <TextBlock Text="Port" />
                    <TextBox Text="{Binding SftpPort}" />
                </StackPanel>
            </Grid>
            <StackPanel Spacing="4">
                <TextBlock Text="Username" />
                <TextBox Text="{Binding SftpUsername}" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="Password" />
                <TextBox Text="{Binding SftpPassword}" PasswordChar="●" />
            </StackPanel>
            <TextBlock Text="Set a Movies remote path, a TV Shows remote path, a Clips remote path, or some combination - each is optional on its own."
                        Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
            <StackPanel Spacing="4">
                <TextBlock Text="Movies Remote Path" />
                <TextBox Text="{Binding SftpMoviesRemotePath}" PlaceholderText="/movies (leave blank if none)" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="TV Shows Remote Path" />
                <TextBox Text="{Binding SftpSeriesRemotePath}" PlaceholderText="/tv (leave blank if none)" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="Clips Remote Path" />
                <TextBox Text="{Binding SftpClipsRemotePath}" PlaceholderText="/clips (leave blank if none)" />
            </StackPanel>
        </StackPanel>

        <TextBlock Text="{Binding ErrorMessage}"
                    Foreground="Red"
                    TextWrapping="Wrap"
                    IsVisible="{Binding HasError}" />
    </StackPanel>
</UserControl>
