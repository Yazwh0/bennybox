<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BitMagic.BennyBox.ViewModels"
             xmlns:controls="using:BitMagic.BennyBox.Controls"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="BitMagic.BennyBox.Views.GuideView"
             x:DataType="vm:GuideViewModel"
             x:Name="RootControl">
    <!-- Outer Panel (not just the inner Grid) hosts the loading overlay as a true sibling of the whole
         scrollable guide, not nested inside the same Grid row as its ScrollViewers - a Border sharing
         Grid.Row="2" with those ScrollViewers silently failed to render at all (not just a contrast
         problem), regardless of z-order/RowSpan/fixed size, seemingly because the virtualized
         ScrollViewer content always composites above row-mate siblings. Being an outer Panel sibling
         sidesteps that entirely. -->
    <Panel>
        <Grid RowDefinitions="Auto,Auto,*">
            <StackPanel Grid.Row="0" Spacing="6" Margin="8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Today" Command="{Binding GoToTodayCommand}" IsEnabled="{Binding !IsLoading}" />
                    <Button Content="◀" Command="{Binding GoToPreviousDayCommand}" IsEnabled="{Binding !IsLoading}" />
                    <Button Content="▶" Command="{Binding GoToNextDayCommand}" IsEnabled="{Binding !IsLoading}" />
                </StackPanel>
                <TextBlock Text="{Binding CurrentDayLabel}" FontWeight="Bold" />
                <TextBlock Text="{Binding LoadError}" Foreground="OrangeRed" TextWrapping="Wrap"
                           IsVisible="{Binding HasLoadError}" />
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBox Grid.Column="0" Text="{Binding SearchText}" PlaceholderText="Search channels or what's on..." />
                    <ui:FAProgressRing Grid.Column="1" IsActive="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                        Width="18" Height="18" Margin="6,0,0,0"
                                        ToolTip.Tip="{Binding RefreshElapsedLabel, TargetNullValue='Loading...'}" />
                    <Button Grid.Column="2" Content="&#8635;" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsLoading}"
                            ToolTip.Tip="Refresh" Margin="6,0,0,0" />
                </Grid>
                <!-- A plain ComboBox for standard click-to-open/select behavior, with a separate TextBox
                     to narrow which categories it shows (FilteredCategories) - typing here never touches
                     SelectedCategory itself, only picking an item from the ComboBox does. -->
                <TextBox Text="{Binding CategoryFilterText}" PlaceholderText="Filter categories..." />
                <ComboBox ItemsSource="{Binding FilteredCategories}" SelectedItem="{Binding SelectedCategory}"
                          HorizontalAlignment="Stretch" />
                <CheckBox Content="Hide channels with no info" IsChecked="{Binding HideEmptyChannels}" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="130,*">
                <Border Grid.Column="0" Background="#19191E" />
                <ScrollViewer Grid.Column="1" Name="TimeHeaderScroll"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <controls:TimeHeaderControl WindowStart="{Binding WindowStartUtc}"
                                                 WindowEnd="{Binding WindowEndUtc}"
                                                 PixelsPerMinute="{Binding PixelsPerMinute}" />
                </ScrollViewer>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="130,*">
                <ScrollViewer Grid.Column="0" Name="ChannelNamesScroll"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GuideRowViewModel">
                                <Border Height="48" BorderBrush="#22262C" BorderThickness="0,0,0,1">
                                    <!-- Padding lives on the Grid (horizontal only), not the Border, so the favorite
                                         button's VerticalAlignment="Stretch" below can reach the row's full height
                                         top-to-bottom - matching Live TV/Series - instead of being inset by 6px
                                         top/bottom the way Border.Padding would apply it. -->
                                    <Grid ColumnDefinitions="Auto,*" Margin="6,0">
                                        <Button Grid.Column="0"
                                                Content="{Binding FavoriteIcon}"
                                                Command="{Binding #RootControl.DataContext.ToggleFavoriteCommand}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Stretch"
                                                Padding="6,0" Margin="0,0,4,0" />
                                        <Button Grid.Column="1"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Command="{Binding #RootControl.DataContext.SelectChannelCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <controls:ChannelLogoImage LogoUrl="{Binding Channel.LogoUrl}"
                                                                            Width="28" Height="28" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding ChannelName}" VerticalAlignment="Center"
                                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ScrollViewer Grid.Column="1" Name="BodyScroll">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GuideRowViewModel">
                                <controls:EpgRowControl Row="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Opaque card, not just floating text - against a guide already full of colourful programme
             blocks, low-opacity text with no background behind it was very hard to read. -->
        <!-- VerticalAlignment="Top" + a fixed Margin, not "Center" - centering measured against this
             Panel's height placed the card almost entirely below the visible window (only a sliver of
             its top edge on screen), for reasons that didn't track the actual visible viewport size.
             Anchoring from the top sidesteps that unresolved height calculation entirely. -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,260,0,0"
                IsVisible="{Binding IsLoading}"
                Background="#33333F" BorderBrush="#55556A" BorderThickness="1" CornerRadius="10" Padding="24,20">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <ui:FAProgressRing IsActive="{Binding IsLoading}" Width="32" Height="32" />
                <TextBlock Text="{Binding RefreshElapsedLabel, TargetNullValue='Loading guide...'}" />
            </StackPanel>
        </Border>
    </Panel>
</UserControl>
