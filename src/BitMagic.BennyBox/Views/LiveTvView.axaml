<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BitMagic.BennyBox.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:controls="using:BitMagic.BennyBox.Controls"
             x:Class="BitMagic.BennyBox.Views.LiveTvView"
             x:DataType="vm:LiveTvViewModel"
             x:Name="RootControl">
    <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Spacing="6" Margin="8,8,8,4">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox Classes="glass" Grid.Column="0" Text="{Binding SearchText}" PlaceholderText="Search channels..." />
                <ui:FAProgressRing Grid.Column="1" IsActive="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                    Width="18" Height="18" Margin="6,0,0,0"
                                    ToolTip.Tip="{Binding RefreshElapsedLabel, TargetNullValue='Loading...'}" />
                <Button Classes="glass-nav" Grid.Column="2" Content="&#8635;" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsLoading}"
                        ToolTip.Tip="Refresh" Margin="6,0,0,0" />
            </Grid>
            <!-- A plain ComboBox for standard click-to-open/select behavior, with a separate TextBox
                 to narrow which categories it shows (FilteredCategories) - typing here never touches
                 SelectedCategory itself, only picking an item from the ComboBox does. -->
            <TextBox Classes="glass" Text="{Binding CategoryFilterText}" PlaceholderText="Filter categories..." />
            <ComboBox Classes="glass" ItemsSource="{Binding FilteredCategories}" SelectedItem="{Binding SelectedCategory}"
                      HorizontalAlignment="Stretch" />
            <TextBlock Text="{Binding LoadError}" Foreground="OrangeRed" TextWrapping="Wrap"
                       IsVisible="{Binding HasLoadError}" />
        </StackPanel>
        <!-- Opaque card, not just floating text - against a list already full of channel logos/rows,
             low-opacity text with no background behind it was very hard to read.
             VerticalAlignment="Top" + a fixed Margin, not "Center" - centering against a row/panel
             containing a VirtualizingStackPanel-based ItemsControl measured to an inflated height,
             placing the card almost entirely below the visible window (see GuideView.axaml for the
             fuller writeup - same underlying issue here). -->
        <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,90,0,0"
                IsVisible="{Binding IsLoading}"
                Background="{StaticResource GlassPanelStrongBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="24,20">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <ui:FAProgressRing IsActive="{Binding IsLoading}" Width="32" Height="32" />
                <TextBlock Text="{Binding RefreshElapsedLabel, TargetNullValue='Loading channels...'}" Foreground="{StaticResource GlassTextBrush}" />
            </StackPanel>
        </Border>
        <!--
            Rows is a flattened list of category headers + channels (see CategoryHeaderRow) shown
            in a single virtualized list, rather than one ItemsControl per category nested inside
            an outer ItemsControl. With 15k+ channels the nested/non-virtualized version realized
            every row's controls up front, which is what made loading the list freeze the UI.
        -->
        <ScrollViewer Grid.Row="1" IsVisible="{Binding !IsLoading}">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="vm:CategoryHeaderRow">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="8,8,8,4" Foreground="{StaticResource GlassTextBrush}" />
                    </DataTemplate>
                    <DataTemplate DataType="vm:ChannelListItemViewModel">
                        <Border Classes="glass-card" Margin="8,4" Padding="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Button Classes="glass-ctrl flat" Grid.Column="0"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding #RootControl.DataContext.SelectChannelCommand}"
                                        CommandParameter="{Binding Channel}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <controls:ChannelLogoImage LogoUrl="{Binding Channel.LogoUrl}"
                                                                    Width="44" Height="44" VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource GlassTextBrush}" />
                                            <TextBlock Text="{Binding NowTitle}"
                                                        FontSize="11" Foreground="{StaticResource GlassTextDimBrush}"
                                                        IsVisible="{Binding HasNowTitle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Classes="glass-nav flat" Grid.Column="1"
                                        Content="{Binding FavoriteIcon}"
                                        Command="{Binding #RootControl.DataContext.ToggleFavoriteCommand}"
                                        CommandParameter="{Binding}"
                                        VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Width="34" Height="34" Padding="0"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Margin="4,0,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
