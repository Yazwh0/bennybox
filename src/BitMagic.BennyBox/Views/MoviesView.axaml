<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BitMagic.BennyBox.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:controls="using:BitMagic.BennyBox.Controls"
             x:Class="BitMagic.BennyBox.Views.MoviesView"
             x:DataType="vm:MoviesViewModel"
             x:Name="RootControl">
    <Grid RowDefinitions="Auto,*">
        <!-- Browsing mode: search + refresh + category filter + the flattened category/movie list. -->
        <StackPanel Grid.Row="0" Spacing="6" Margin="8,8,8,4"
                    IsVisible="{Binding SelectedMovie, Converter={x:Static conv:ObjectConverters.IsNull}}">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox Classes="glass" Grid.Column="0" Text="{Binding SearchText}" PlaceholderText="Search movies..." />
                <ui:FAProgressRing Grid.Column="1" IsActive="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                    Width="18" Height="18" Margin="6,0,0,0"
                                    ToolTip.Tip="{Binding RefreshElapsedLabel, TargetNullValue='Loading...'}" />
                <Button Classes="glass-nav" Grid.Column="2" Content="&#8635;" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsLoading}"
                        ToolTip.Tip="Refresh" Margin="6,0,0,0" />
            </Grid>
            <!-- A plain ComboBox for standard click-to-open/select behavior, with a separate TextBox
                 to narrow which categories it shows (FilteredCategories) - typing here never touches
                 SelectedCategory itself, only picking an item from the ComboBox does. -->
            <TextBox Classes="glass" Text="{Binding CategoryFilterText}" PlaceholderText="Filter categories..." />
            <ComboBox Classes="glass" ItemsSource="{Binding FilteredCategories}" SelectedItem="{Binding SelectedCategory}"
                      HorizontalAlignment="Stretch" />
            <TextBlock Text="{Binding LoadError}" Foreground="OrangeRed" TextWrapping="Wrap"
                       IsVisible="{Binding HasLoadError}" />
        </StackPanel>
        <!-- Opaque card, not just floating text - against a list already full of cover art/rows,
             low-opacity text with no background behind it was very hard to read.
             VerticalAlignment="Top" + a fixed Margin, not "Center" - centering against a row/panel
             containing a VirtualizingStackPanel-based ItemsControl measured to an inflated height,
             placing the card almost entirely below the visible window (see GuideView.axaml for the
             fuller writeup - same underlying issue here). -->
        <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,90,0,0"
                IsVisible="{Binding IsLoading}"
                Background="{StaticResource GlassPanelStrongBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="24,20">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <ui:FAProgressRing IsActive="{Binding IsLoading}" Width="32" Height="32" />
                <TextBlock Text="{Binding RefreshElapsedLabel, TargetNullValue='Loading movies...'}" Foreground="{StaticResource GlassTextBrush}" />
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="1" Text="No movies available yet - add an Xtream profile and refresh it in Settings."
                   Margin="16" TextWrapping="Wrap" Opacity="0.7">
            <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                    <Binding Path="!IsLoading" />
                    <Binding Path="HasNoMovies" />
                </MultiBinding>
            </TextBlock.IsVisible>
        </TextBlock>
        <TextBlock Grid.Row="1" Text="No matches found." Margin="16" TextWrapping="Wrap" Opacity="0.7">
            <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                    <Binding Path="!IsLoading" />
                    <Binding Path="HasNoMatches" />
                </MultiBinding>
            </TextBlock.IsVisible>
        </TextBlock>
        <ScrollViewer Grid.Row="1">
            <ScrollViewer.IsVisible>
                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                    <Binding Path="!IsLoading" />
                    <Binding Path="SelectedMovie" Converter="{x:Static conv:ObjectConverters.IsNull}" />
                </MultiBinding>
            </ScrollViewer.IsVisible>
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="vm:CategoryHeaderRow">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="8,8,8,4" Foreground="{StaticResource GlassTextBrush}" />
                    </DataTemplate>
                    <DataTemplate DataType="vm:MovieListItemViewModel">
                        <Grid ColumnDefinitions="Auto,Auto,*" Margin="8,1">
                            <Button Classes="glass-nav" Grid.Column="0"
                                    Content="{Binding FavoriteIcon}"
                                    Command="{Binding #RootControl.DataContext.ToggleFavoriteCommand}"
                                    CommandParameter="{Binding}"
                                    VerticalAlignment="Stretch"
                                    Padding="6,0" Margin="0,0,4,0" />
                            <Button Classes="glass-nav" Grid.Column="1"
                                    Content="{Binding WatchedIcon}"
                                    ToolTip.Tip="Toggle watched"
                                    Command="{Binding #RootControl.DataContext.ToggleWatchedCommand}"
                                    CommandParameter="{Binding}"
                                    VerticalAlignment="Stretch" MinWidth="28"
                                    Padding="6,0" Margin="0,0,4,0" />
                            <Button Classes="glass-ctrl" Grid.Column="2"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Command="{Binding #RootControl.DataContext.SelectMovieCommand}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal" Spacing="8" Opacity="{Binding ContentOpacity}">
                                    <controls:ChannelLogoImage LogoUrl="{Binding CoverUrl}"
                                                                Width="44" Height="44" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource GlassTextBrush}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </ScrollViewer>

        <!-- Detail mode: a selected movie's poster/plot/rating and a Play button, shown instead of the
             list above. Plot/genre/release date arrive asynchronously (on-demand get_vod_info fetch,
             see MoviesViewModel.SelectMovieAsync) - the poster/name/rating already known from the bulk
             import show immediately, the rest fades in once IsLoadingDetails clears. -->
        <Grid Grid.Row="0" Grid.RowSpan="2" RowDefinitions="Auto,Auto,*"
              IsVisible="{Binding SelectedMovie, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
            <Button Classes="glass-ctrl" Grid.Row="0" Content="&#8592; Back to Movies" Command="{Binding BackToListCommand}" Margin="8,8,8,4" HorizontalAlignment="Stretch" />
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="8,4">
                <controls:ChannelLogoImage Grid.Column="0" LogoUrl="{Binding SelectedMovie.CoverUrl}"
                                            Width="110" Height="165" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="6" VerticalAlignment="Top">
                    <TextBlock Text="{Binding SelectedMovie.Name}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedMovie.MetaLine}" FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                               IsVisible="{Binding SelectedMovie.HasMetaLine}" />
                    <ui:FAProgressRing IsActive="{Binding SelectedMovie.IsLoadingDetails}" Width="20" Height="20"
                                       HorizontalAlignment="Left"
                                       IsVisible="{Binding SelectedMovie.IsLoadingDetails}" />
                    <TextBlock Text="{Binding SelectedMovie.Plot}" FontSize="12" Opacity="0.85" TextWrapping="Wrap"
                               IsVisible="{Binding SelectedMovie.HasPlot}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                        <Button Classes="glass-ctrl accent" Content="▶ Play" Command="{Binding PlayMovieCommand}" CommandParameter="{Binding SelectedMovie}" />
                        <Button Classes="glass-nav" Content="{Binding SelectedMovie.WatchedIcon}" ToolTip.Tip="Toggle watched" MinWidth="32"
                                Command="{Binding ToggleWatchedCommand}" CommandParameter="{Binding SelectedMovie}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
