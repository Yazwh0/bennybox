<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BitMagic.BennyBox.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:controls="using:BitMagic.BennyBox.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="BitMagic.BennyBox.Views.SearchView"
             x:DataType="vm:SearchViewModel"
             x:Name="RootControl">
    <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Spacing="6" Margin="8,8,8,4">
            <TextBox Classes="glass" Text="{Binding SearchText}" PlaceholderText="Search Live TV, Series, and Movies..." />
            <TextBlock Text="{Binding LoadError}" Foreground="OrangeRed" TextWrapping="Wrap"
                       IsVisible="{Binding HasLoadError}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsVisible="{Binding IsLoading}">
            <ui:FAProgressRing IsActive="{Binding IsLoading}" Width="32" Height="32" />
            <TextBlock Text="Loading..." Opacity="0.7" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="Type to search across Live TV, Series, and Movies."
                   Margin="16" TextWrapping="Wrap" Opacity="0.7">
            <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                    <Binding Path="!IsLoading" />
                    <Binding Path="HasEmptyQuery" />
                </MultiBinding>
            </TextBlock.IsVisible>
        </TextBlock>
        <TextBlock Grid.Row="1" Text="No matches found." Margin="16" TextWrapping="Wrap" Opacity="0.7">
            <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                    <Binding Path="!IsLoading" />
                    <Binding Path="HasNoMatches" />
                </MultiBinding>
            </TextBlock.IsVisible>
        </TextBlock>
        <ScrollViewer Grid.Row="1" IsVisible="{Binding !IsLoading}">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="vm:CategoryHeaderRow">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="8,8,8,4" Foreground="{StaticResource GlassTextBrush}" />
                    </DataTemplate>
                    <DataTemplate DataType="vm:ChannelListItemViewModel">
                        <Grid ColumnDefinitions="Auto,*" Margin="8,1">
                            <Button Classes="glass-nav" Grid.Column="0"
                                    Content="{Binding FavoriteIcon}"
                                    Command="{Binding #RootControl.DataContext.ToggleChannelFavoriteCommand}"
                                    CommandParameter="{Binding}"
                                    VerticalAlignment="Stretch"
                                    Padding="6,0" Margin="0,0,4,0" />
                            <Button Classes="glass-ctrl" Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Command="{Binding #RootControl.DataContext.SelectChannelCommand}"
                                    CommandParameter="{Binding Channel}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <controls:ChannelLogoImage LogoUrl="{Binding Channel.LogoUrl}"
                                                                FallbackLogoUrl="{Binding FallbackLogoUrl}"
                                                                TmdbFallbackTitle="{Binding Name}"
                                                                Width="44" Height="44" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource GlassTextBrush}" />
                                        <TextBlock Text="{Binding NowTitle}"
                                                    FontSize="11" Foreground="{StaticResource GlassTextDimBrush}"
                                                    IsVisible="{Binding HasNowTitle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </DataTemplate>
                    <DataTemplate DataType="vm:SeriesListItemViewModel">
                        <Grid ColumnDefinitions="Auto,*" Margin="8,1">
                            <Button Classes="glass-nav" Grid.Column="0"
                                    Content="{Binding FavoriteIcon}"
                                    Command="{Binding #RootControl.DataContext.ToggleSeriesFavoriteCommand}"
                                    CommandParameter="{Binding}"
                                    VerticalAlignment="Stretch"
                                    Padding="6,0" Margin="0,0,4,0" />
                            <Button Classes="glass-ctrl" Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Command="{Binding #RootControl.DataContext.SelectSeriesCommand}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal" Spacing="8" Opacity="{Binding ContentOpacity}">
                                    <controls:ChannelLogoImage LogoUrl="{Binding CoverUrl}"
                                                                Width="44" Height="44" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource GlassTextBrush}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </DataTemplate>
                    <DataTemplate DataType="vm:MovieListItemViewModel">
                        <Grid ColumnDefinitions="Auto,Auto,Auto,*" Margin="8,1">
                            <Button Classes="glass-nav" Grid.Column="0"
                                    Content="{Binding FavoriteIcon}"
                                    Command="{Binding #RootControl.DataContext.ToggleMovieFavoriteCommand}"
                                    CommandParameter="{Binding}"
                                    VerticalAlignment="Stretch"
                                    Padding="6,0" Margin="0,0,4,0" />
                            <Button Classes="glass-nav" Grid.Column="1"
                                    Content="{Binding WatchedIcon}"
                                    ToolTip.Tip="Toggle watched"
                                    Command="{Binding #RootControl.DataContext.ToggleMovieWatchedCommand}"
                                    CommandParameter="{Binding}"
                                    VerticalAlignment="Stretch" Width="34" Padding="0"
                                    HorizontalContentAlignment="Center"
                                    Margin="0,0,4,0" />
                            <Button Classes="glass-nav" Grid.Column="2"
                                    Content="{Binding DownloadIcon}"
                                    ToolTip.Tip="Download to this device"
                                    Command="{Binding #RootControl.DataContext.DownloadMovieCommand}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding CanDownload}"
                                    IsVisible="{Binding !IsFromDownloadsProfile}"
                                    VerticalAlignment="Stretch" MinWidth="28"
                                    Padding="6,0" Margin="0,0,4,0" />
                            <Button Classes="glass-ctrl" Grid.Column="3"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Command="{Binding #RootControl.DataContext.SelectMovieCommand}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal" Spacing="8" Opacity="{Binding ContentOpacity}">
                                    <controls:ChannelLogoImage LogoUrl="{Binding CoverUrl}"
                                                                Width="44" Height="44" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource GlassTextBrush}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </DataTemplate>
                    <DataTemplate DataType="vm:ClipListItemViewModel">
                        <Grid ColumnDefinitions="Auto,Auto,Auto,*" Margin="8,1">
                            <Button Classes="glass-nav" Grid.Column="0"
                                    Content="{Binding FavoriteIcon}"
                                    Command="{Binding #RootControl.DataContext.ToggleClipFavoriteCommand}"
                                    CommandParameter="{Binding}"
                                    VerticalAlignment="Stretch"
                                    Padding="6,0" Margin="0,0,4,0" />
                            <Button Classes="glass-nav" Grid.Column="1"
                                    Content="{Binding WatchedIcon}"
                                    ToolTip.Tip="Toggle watched"
                                    Command="{Binding #RootControl.DataContext.ToggleClipWatchedCommand}"
                                    CommandParameter="{Binding}"
                                    VerticalAlignment="Stretch" Width="34" Padding="0"
                                    HorizontalContentAlignment="Center"
                                    Margin="0,0,4,0" />
                            <Button Classes="glass-nav" Grid.Column="2"
                                    Content="{Binding DownloadIcon}"
                                    ToolTip.Tip="Download to this device"
                                    Command="{Binding #RootControl.DataContext.DownloadClipCommand}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding CanDownload}"
                                    IsVisible="{Binding !IsFromDownloadsProfile}"
                                    VerticalAlignment="Stretch" MinWidth="28"
                                    Padding="6,0" Margin="0,0,4,0" />
                            <Button Classes="glass-ctrl" Grid.Column="3"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Command="{Binding #RootControl.DataContext.SelectClipCommand}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal" Spacing="8" Opacity="{Binding ContentOpacity}">
                                    <controls:ChannelLogoImage LogoUrl="{Binding CoverUrl}"
                                                                Width="44" Height="44" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource GlassTextBrush}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
