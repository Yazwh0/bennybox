<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BitMagic.BennyBox.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:controls="using:BitMagic.BennyBox.Controls"
             x:Class="BitMagic.BennyBox.Views.SeriesView"
             x:DataType="vm:SeriesViewModel"
             x:Name="RootControl">
    <Grid RowDefinitions="Auto,*">
        <!-- Browsing mode: search + refresh + category filter + the flattened category/series list. -->
        <StackPanel Grid.Row="0" Spacing="6" Margin="8,8,8,4"
                    IsVisible="{Binding SelectedSeries, Converter={x:Static conv:ObjectConverters.IsNull}}">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox Classes="glass" Grid.Column="0" Text="{Binding SearchText}" PlaceholderText="Search series..." />
                <ui:FAProgressRing Grid.Column="1" IsActive="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                    Width="18" Height="18" Margin="6,0,0,0"
                                    ToolTip.Tip="{Binding RefreshElapsedLabel, TargetNullValue='Loading...'}" />
                <Button Classes="glass-nav" Grid.Column="2" Content="&#8635;" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsLoading}"
                        ToolTip.Tip="Refresh" Margin="6,0,0,0" />
            </Grid>
            <!-- A plain ComboBox for standard click-to-open/select behavior, with a separate TextBox
                 to narrow which categories it shows (FilteredCategories) - typing here never touches
                 SelectedCategory itself, only picking an item from the ComboBox does. -->
            <TextBox Classes="glass" Text="{Binding CategoryFilterText}" PlaceholderText="Filter categories..." />
            <ComboBox Classes="glass" ItemsSource="{Binding FilteredCategories}" SelectedItem="{Binding SelectedCategory}"
                      HorizontalAlignment="Stretch" />
            <!-- See MoviesView's equivalent Sources ComboBox for why this is always shown. -->
            <ComboBox Classes="glass" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                      HorizontalAlignment="Stretch" />
            <TextBlock Text="{Binding LoadError}" Foreground="OrangeRed" TextWrapping="Wrap"
                       IsVisible="{Binding HasLoadError}" />
        </StackPanel>
        <!-- Opaque card, not just floating text - against a list already full of cover art/rows,
             low-opacity text with no background behind it was very hard to read.
             VerticalAlignment="Top" + a fixed Margin, not "Center" - centering against a row/panel
             containing a VirtualizingStackPanel-based ItemsControl measured to an inflated height,
             placing the card almost entirely below the visible window (see GuideView.axaml for the
             fuller writeup - same underlying issue here). -->
        <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,90,0,0"
                IsVisible="{Binding IsLoading}"
                Background="{StaticResource GlassPanelStrongBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="24,20">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <ui:FAProgressRing IsActive="{Binding IsLoading}" Width="32" Height="32" />
                <TextBlock Text="{Binding RefreshElapsedLabel, TargetNullValue='Loading series...'}" Foreground="{StaticResource GlassTextBrush}" />
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="1" Text="No series available yet - add an Xtream profile and refresh it in Settings."
                   Margin="16" TextWrapping="Wrap" Opacity="0.7">
            <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                    <Binding Path="!IsLoading" />
                    <Binding Path="HasNoSeries" />
                </MultiBinding>
            </TextBlock.IsVisible>
        </TextBlock>
        <TextBlock Grid.Row="1" Text="No matches found." Margin="16" TextWrapping="Wrap" Opacity="0.7">
            <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                    <Binding Path="!IsLoading" />
                    <Binding Path="HasNoMatches" />
                </MultiBinding>
            </TextBlock.IsVisible>
        </TextBlock>
        <ScrollViewer Grid.Row="1">
            <ScrollViewer.IsVisible>
                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                    <Binding Path="!IsLoading" />
                    <Binding Path="SelectedSeries" Converter="{x:Static conv:ObjectConverters.IsNull}" />
                </MultiBinding>
            </ScrollViewer.IsVisible>
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="vm:CategoryHeaderRow">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="8,8,8,4" Foreground="{StaticResource GlassTextBrush}" />
                    </DataTemplate>
                    <DataTemplate DataType="vm:SeriesListItemViewModel">
                        <Grid ColumnDefinitions="Auto,*" Margin="8,1">
                            <Button Classes="glass-nav" Grid.Column="0"
                                    Content="{Binding FavoriteIcon}"
                                    Command="{Binding #RootControl.DataContext.ToggleFavoriteCommand}"
                                    CommandParameter="{Binding}"
                                    VerticalAlignment="Stretch"
                                    Padding="6,0" Margin="0,0,4,0" />
                            <Button Classes="glass-ctrl" Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Command="{Binding #RootControl.DataContext.SelectSeriesCommand}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal" Spacing="8" Opacity="{Binding ContentOpacity}">
                                    <controls:ChannelLogoImage LogoUrl="{Binding CoverUrl}"
                                                                Width="44" Height="44" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Foreground="{StaticResource GlassTextBrush}" />
                                        <Border Classes="source-badge" HorizontalAlignment="Left">
                                            <TextBlock Classes="source-badge-text" Text="{Binding SourceName}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </ScrollViewer>

        <!-- Detail mode: a selected series' seasons/episodes, shown instead of the list above. -->
        <Grid Grid.Row="0" Grid.RowSpan="2" RowDefinitions="Auto,Auto,*"
              IsVisible="{Binding SelectedSeries, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
            <Button Classes="glass-ctrl" Grid.Row="0" Content="&#8592; Back to Series" Command="{Binding BackToListCommand}" Margin="8,8,8,4" HorizontalAlignment="Stretch" />
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="8,4">
                <controls:ChannelLogoImage Grid.Column="0" LogoUrl="{Binding SelectedSeries.CoverUrl}"
                                            Width="110" Height="165" VerticalAlignment="Top" />
                <!-- MaxLines+ellipsis on both Name and Plot - without this, a long title (e.g. "Married
                     At First Sight Australia") or a wordy plot summary makes this Auto-height header
                     balloon, squeezing the episode list below (the only Row="*") down to a sliver
                     regardless of how many episodes there are to navigate. -->
                <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="6" VerticalAlignment="Top">
                    <TextBlock Text="{Binding SelectedSeries.Name}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap"
                               MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedSeries.Name}" />
                    <Border Classes="source-badge" HorizontalAlignment="Left">
                        <TextBlock Classes="source-badge-text" Text="{Binding SelectedSeries.SourceName}" />
                    </Border>
                    <TextBlock Text="{Binding SelectedSeries.MetaLine}" FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                               IsVisible="{Binding SelectedSeries.HasMetaLine}" />
                    <TextBlock Text="{Binding SelectedSeries.Plot}" FontSize="12" Opacity="0.85" TextWrapping="Wrap"
                               MaxLines="6" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding SelectedSeries.HasPlot}" ToolTip.Tip="{Binding SelectedSeries.Plot}" />
                    <!-- Six lines still isn't always the whole plot - this is the actual "read it all"
                         path: a Flyout floats above the layout rather than pushing it down, so reading
                         the full description never costs the episode list any space. -->
                    <Button Content="Read full description" FontSize="11" Padding="0" Margin="0,-2,0,0"
                            Background="Transparent" BorderThickness="0" HorizontalAlignment="Left"
                            IsVisible="{Binding SelectedSeries.HasPlot}">
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <ScrollViewer MaxHeight="400" MaxWidth="360">
                                    <TextBlock Text="{Binding SelectedSeries.Plot}" TextWrapping="Wrap" Margin="8" />
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="2" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsVisible="{Binding IsLoadingEpisodes}">
                <ui:FAProgressRing IsActive="{Binding IsLoadingEpisodes}" Width="32" Height="32" />
                <TextBlock Text="Loading episodes..." Opacity="0.7" />
            </StackPanel>
            <ScrollViewer Grid.Row="2" IsVisible="{Binding !IsLoadingEpisodes}">
                <ItemsControl ItemsSource="{Binding Episodes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.DataTemplates>
                        <DataTemplate DataType="vm:CategoryHeaderRow">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="8,8,8,4" Foreground="{StaticResource GlassTextBrush}" />
                        </DataTemplate>
                        <DataTemplate DataType="vm:EpisodeListItemViewModel">
                            <Grid ColumnDefinitions="Auto,*" Margin="8,1">
                                <Button Classes="glass-nav" Grid.Column="0"
                                        Content="{Binding WatchedIcon}"
                                        ToolTip.Tip="Toggle watched"
                                        Command="{Binding #RootControl.DataContext.ToggleEpisodeWatchedCommand}"
                                        CommandParameter="{Binding}"
                                        VerticalAlignment="Stretch" MinWidth="28"
                                        Padding="6,0" Margin="0,0,4,0" />
                                <Button Classes="glass-ctrl" Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding #RootControl.DataContext.PlayEpisodeCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Opacity="{Binding ContentOpacity}">
                                        <TextBlock Text="{Binding SeasonEpisodeLabel}" FontSize="11" Foreground="{StaticResource GlassTextDimBrush}" />
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Foreground="{StaticResource GlassTextBrush}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
