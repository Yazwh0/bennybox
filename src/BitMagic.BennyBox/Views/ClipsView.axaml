<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BitMagic.BennyBox.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:controls="using:BitMagic.BennyBox.Controls"
             x:Class="BitMagic.BennyBox.Views.ClipsView"
             x:DataType="vm:ClipsViewModel"
             x:Name="RootControl">
    <Grid RowDefinitions="Auto,*">
        <!-- Browsing mode: search + refresh + category filter + the flattened category/clip list.
             See MoviesView - identical structure. -->
        <StackPanel Grid.Row="0" Spacing="6" Margin="8,8,8,4"
                    IsVisible="{Binding SelectedClip, Converter={x:Static conv:ObjectConverters.IsNull}}">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox Classes="glass" Grid.Column="0" Text="{Binding SearchText}" PlaceholderText="Search clips..." />
                <ui:FAProgressRing Grid.Column="1" IsActive="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                    Width="18" Height="18" Margin="6,0,0,0"
                                    ToolTip.Tip="{Binding RefreshElapsedLabel, TargetNullValue='Loading...'}" />
                <Button Classes="glass-nav" Grid.Column="2" Content="&#8635;" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsLoading}"
                        ToolTip.Tip="Refresh" Margin="6,0,0,0" />
            </Grid>
            <TextBox Classes="glass" Text="{Binding CategoryFilterText}" PlaceholderText="Filter categories..." />
            <ComboBox Classes="glass" ItemsSource="{Binding FilteredCategories}" SelectedItem="{Binding SelectedCategory}"
                      HorizontalAlignment="Stretch" />
            <ComboBox Classes="glass" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                      HorizontalAlignment="Stretch" />
            <TextBlock Text="{Binding LoadError}" Foreground="OrangeRed" TextWrapping="Wrap"
                       IsVisible="{Binding HasLoadError}" />
        </StackPanel>
        <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,90,0,0"
                IsVisible="{Binding IsLoading}"
                Background="{StaticResource GlassPanelStrongBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="24,20">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <ui:FAProgressRing IsActive="{Binding IsLoading}" Width="32" Height="32" />
                <TextBlock Text="{Binding RefreshElapsedLabel, TargetNullValue='Loading clips...'}" Foreground="{StaticResource GlassTextBrush}" />
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="1" Text="No clips available yet - set a Clips folder on a Local Folder or SFTP profile and refresh it in Settings."
                   Margin="16" TextWrapping="Wrap" Opacity="0.7">
            <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                    <Binding Path="!IsLoading" />
                    <Binding Path="HasNoClips" />
                </MultiBinding>
            </TextBlock.IsVisible>
        </TextBlock>
        <TextBlock Grid.Row="1" Text="No matches found." Margin="16" TextWrapping="Wrap" Opacity="0.7">
            <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                    <Binding Path="!IsLoading" />
                    <Binding Path="HasNoMatches" />
                </MultiBinding>
            </TextBlock.IsVisible>
        </TextBlock>
        <ScrollViewer Grid.Row="1">
            <ScrollViewer.IsVisible>
                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                    <Binding Path="!IsLoading" />
                    <Binding Path="SelectedClip" Converter="{x:Static conv:ObjectConverters.IsNull}" />
                </MultiBinding>
            </ScrollViewer.IsVisible>
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="vm:CategoryHeaderRow">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="8,8,8,4" Foreground="{StaticResource GlassTextBrush}" />
                    </DataTemplate>
                    <DataTemplate DataType="vm:ClipListItemViewModel">
                        <Grid ColumnDefinitions="Auto,Auto,Auto,*" Margin="8,1">
                            <Button Classes="glass-nav" Grid.Column="0"
                                    Content="{Binding FavoriteIcon}"
                                    Command="{Binding #RootControl.DataContext.ToggleFavoriteCommand}"
                                    CommandParameter="{Binding}"
                                    VerticalAlignment="Stretch"
                                    Padding="6,0" Margin="0,0,4,0" />
                            <Button Classes="glass-nav" Grid.Column="1"
                                    Content="{Binding WatchedIcon}"
                                    ToolTip.Tip="Toggle watched"
                                    Command="{Binding #RootControl.DataContext.ToggleWatchedCommand}"
                                    CommandParameter="{Binding}"
                                    VerticalAlignment="Stretch" MinWidth="28"
                                    Padding="6,0" Margin="0,0,4,0" />
                            <Button Classes="glass-nav" Grid.Column="2"
                                    Content="{Binding DownloadIcon}"
                                    ToolTip.Tip="Download to this device"
                                    Command="{Binding #RootControl.DataContext.DownloadCommand}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding CanDownload}"
                                    IsVisible="{Binding !IsFromDownloadsProfile}"
                                    VerticalAlignment="Stretch" MinWidth="28"
                                    Padding="6,0" Margin="0,0,4,0" />
                            <Button Classes="glass-ctrl" Grid.Column="3"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Command="{Binding #RootControl.DataContext.SelectClipCommand}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal" Spacing="8" Opacity="{Binding ContentOpacity}">
                                    <controls:ChannelLogoImage LogoUrl="{Binding CoverUrl}"
                                                                Width="44" Height="44" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Foreground="{StaticResource GlassTextBrush}" />
                                        <Border Classes="source-badge" HorizontalAlignment="Left">
                                            <TextBlock Classes="source-badge-text" Text="{Binding SourceName}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </ScrollViewer>

        <!-- Detail mode: a selected clip's poster/plot/rating (from an NFO if one happened to exist -
             never TMDb) and a Play button, shown instead of the list above. Unlike MoviesView, there's
             no "loading details" spinner - a clip's detail is already final the moment the scan
             produced it, see ClipListItemViewModel. -->
        <Grid Grid.Row="0" Grid.RowSpan="2" RowDefinitions="Auto,Auto,*"
              IsVisible="{Binding SelectedClip, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
            <Button Classes="glass-ctrl" Grid.Row="0" Content="&#8592; Back to Clips" Command="{Binding BackToListCommand}" Margin="8,8,8,4" HorizontalAlignment="Stretch" />
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="8,4">
                <controls:ChannelLogoImage Grid.Column="0" LogoUrl="{Binding SelectedClip.CoverUrl}"
                                            Width="110" Height="165" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="6" VerticalAlignment="Top">
                    <TextBlock Text="{Binding SelectedClip.Name}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" />
                    <Border Classes="source-badge" HorizontalAlignment="Left">
                        <TextBlock Classes="source-badge-text" Text="{Binding SelectedClip.SourceName}" />
                    </Border>
                    <TextBlock Text="{Binding SelectedClip.MetaLine}" FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                               IsVisible="{Binding SelectedClip.HasMetaLine}" />
                    <TextBlock Text="{Binding SelectedClip.Plot}" FontSize="12" Opacity="0.85" TextWrapping="Wrap"
                               IsVisible="{Binding SelectedClip.HasPlot}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                        <Button Classes="glass-ctrl accent" Content="▶ Play" Command="{Binding PlayClipCommand}" CommandParameter="{Binding SelectedClip}" />
                        <Button Classes="glass-nav" Content="{Binding SelectedClip.WatchedIcon}" ToolTip.Tip="Toggle watched" MinWidth="32"
                                Command="{Binding ToggleWatchedCommand}" CommandParameter="{Binding SelectedClip}" />
                        <Button Classes="glass-nav" Content="{Binding SelectedClip.DownloadIcon}" ToolTip.Tip="Download to this device" MinWidth="32"
                                Command="{Binding DownloadCommand}" CommandParameter="{Binding SelectedClip}"
                                IsEnabled="{Binding SelectedClip.CanDownload}" IsVisible="{Binding !SelectedClip.IsFromDownloadsProfile}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
