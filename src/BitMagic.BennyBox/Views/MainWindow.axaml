<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BitMagic.BennyBox.ViewModels"
        xmlns:vlc="using:LibVLCSharp.Avalonia"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        x:Class="BitMagic.BennyBox.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="avares://BitMagic.BennyBox/Assets/icon.ico"
        Title="Benny Box"
        TransparencyLevelHint="AcrylicBlur"
        Background="{Binding Settings.WindowBackgroundOpacityPercent, Converter={StaticResource WindowBackgroundOpacityToBrushConverter}}"
        Width="1280" Height="800">
    <Window.Styles>
        <Style Selector="GridSplitter:pointerover">
            <Setter Property="Background" Value="#8A6A45" />
        </Style>
        <Style Selector="GridSplitter:pressed">
            <Setter Property="Background" Value="#D9995A" />
        </Style>
    </Window.Styles>
    <!-- The video area lives here once, permanently, rather than once per page (as it used to).
         LibVLC's video surface is a native child window - swapping pages used to destroy and
         recreate it each time, and the replacement didn't reliably reclaim rendering, so video
         went black on navigation while audio (not tied to the surface) kept playing. Each page
         now only supplies its own list/detail content via CurrentPage, shown below the nav
         buttons in the same sidebar column; Settings is the one page with no video, handled by
         collapsing the video column to 0 and giving the sidebar column the full width instead
         (see the ContentArea*/VideoColumnWidth converters). -->
    <Grid x:Name="RootGrid"
          Margin="{Binding Player.IsFullscreen, Converter={StaticResource FullscreenToMarginConverter}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition MaxWidth="{Binding IsSettingsActive, Converter={StaticResource ContentAreaMaxWidthConverter}}">
                <ColumnDefinition.Width>
                    <MultiBinding Converter="{StaticResource ContentAreaWidthConverter}">
                        <Binding Path="IsSettingsActive" />
                        <Binding Path="Player.IsFullscreen" />
                        <Binding Path="Player.SidebarWidth" />
                    </MultiBinding>
                </ColumnDefinition.Width>
                <ColumnDefinition.MinWidth>
                    <MultiBinding Converter="{StaticResource ContentAreaMinWidthConverter}">
                        <Binding Path="IsSettingsActive" />
                        <Binding Path="Player.IsFullscreen" />
                    </MultiBinding>
                </ColumnDefinition.MinWidth>
            </ColumnDefinition>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="{Binding IsSettingsActive, Converter={StaticResource VideoColumnWidthConverter}}" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" x:Name="SidebarContentGrid" RowDefinitions="Auto,Auto,*" IsVisible="{Binding !Player.IsFullscreen}">
            <!-- App-wide "X is starting now" banner for in-app EPG reminders (see GuideView's per-
                 programme reminder toggle) - lives above the nav row so it's visible from any page,
                 not just Guide. -->
            <Border Grid.Row="0" Background="#2D5F3A" Padding="10,6" Margin="8,8,8,0" CornerRadius="4"
                    IsVisible="{Binding HasDueReminder}">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap">
                        <Run Text="{Binding DueReminder.ChannelName}" FontWeight="Bold" />
                        <Run Text=" - " />
                        <Run Text="{Binding DueReminder.ProgrammeTitle}" />
                        <Run Text=" is starting now" />
                    </TextBlock>
                    <Button Grid.Column="1" Content="Watch" Command="{Binding WatchReminderCommand}" Margin="8,0,0,0" />
                    <Button Grid.Column="2" Content="✕" Command="{Binding DismissReminderCommand}" Margin="4,0,0,0" />
                </Grid>
            </Border>
            <!-- Nav "pane" is just a row of buttons above the page content now, instead of its own
                 separate column. Icon-only and deliberately condensed to one row (not a wrapping
                 WrapPanel) so the sidebar's remaining height goes to the actual channel/series/movie
                 lists below rather than the nav itself. ToolTip.Tip carries the label that used to be
                 visible text. -->
            <!-- MaxWidth+Left alignment only kick in while Settings is active, where this sidebar
                 column widens to the full window (see IsSettingsActive/ContentArea*Converter) - without
                 that cap, UniformGrid would stretch all cells across that whole width, leaving each
                 icon marooned in the middle of a huge empty cell. Everywhere else it stretches to fill
                 the sidebar's actual width, so the buttons resize as the window/sidebar is resized
                 instead of sitting fixed-size with dead space to the right. -->
            <!-- Columns is set from code-behind (see UpdateNavColumns in MainWindow.axaml.cs), not
                 fixed in markup - it's always either 10 (one row, when SidebarContentGrid is wide
                 enough for every button to get a comfortable width) or 5 (two even rows), never
                 something lopsided like 8+2. A plain WrapPanel was tried first, but it wraps greedily
                 based on however many buttons happen to fit per line, which produces exactly that kind
                 of uneven split - UniformGrid always gives evenly-sized rows for whichever column count
                 it's told to use, so the two-value toggle lives outside it instead. -->
            <UniformGrid Grid.Row="1" x:Name="NavBar" Columns="5" Margin="8,8,8,4"
                         MaxWidth="{Binding IsSettingsActive, Converter={StaticResource NavBarMaxWidthConverter}}"
                         HorizontalAlignment="{Binding IsSettingsActive, Converter={StaticResource NavBarHorizontalAlignmentConverter}}">
                <Button Classes="glass-nav" Command="{Binding NavigateCommand}" CommandParameter="Search" Padding="7,6" Margin="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="{Binding CurrentPageTag, Converter={StaticResource ActiveTagToBackgroundConverter}, ConverterParameter=Search}"
                        ToolTip.Tip="Search">
                    <ui:FASymbolIcon Symbol="Find" FontSize="16" />
                </Button>
                <Button Classes="glass-nav" Command="{Binding NavigateCommand}" CommandParameter="LiveTv" Padding="7,6" Margin="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="{Binding CurrentPageTag, Converter={StaticResource ActiveTagToBackgroundConverter}, ConverterParameter=LiveTv}"
                        ToolTip.Tip="Live TV">
                    <ui:FASymbolIcon Symbol="Video" FontSize="16" />
                </Button>
                <Button Classes="glass-nav" Command="{Binding NavigateCommand}" CommandParameter="Guide" Padding="7,6" Margin="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="{Binding CurrentPageTag, Converter={StaticResource ActiveTagToBackgroundConverter}, ConverterParameter=Guide}"
                        ToolTip.Tip="Guide">
                    <ui:FASymbolIcon Symbol="CalendarDay" FontSize="16" />
                </Button>
                <Button Classes="glass-nav" Command="{Binding NavigateCommand}" CommandParameter="Series" Padding="7,6" Margin="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="{Binding CurrentPageTag, Converter={StaticResource ActiveTagToBackgroundConverter}, ConverterParameter=Series}"
                        ToolTip.Tip="Series">
                    <ui:FASymbolIcon Symbol="List" FontSize="16" />
                </Button>
                <Button Classes="glass-nav" Command="{Binding NavigateCommand}" CommandParameter="Movies" Padding="7,6" Margin="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="{Binding CurrentPageTag, Converter={StaticResource ActiveTagToBackgroundConverter}, ConverterParameter=Movies}"
                        ToolTip.Tip="Movies">
                    <ui:FASymbolIcon Symbol="Library" FontSize="16" />
                </Button>
                <Button Classes="glass-nav" Command="{Binding NavigateCommand}" CommandParameter="Clips" Padding="7,6" Margin="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="{Binding CurrentPageTag, Converter={StaticResource ActiveTagToBackgroundConverter}, ConverterParameter=Clips}"
                        ToolTip.Tip="Clips">
                    <ui:FASymbolIcon Symbol="Flag" FontSize="16" />
                </Button>
                <Button Classes="glass-nav" Command="{Binding NavigateCommand}" CommandParameter="Downloads" Padding="7,6" Margin="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="{Binding CurrentPageTag, Converter={StaticResource ActiveTagToBackgroundConverter}, ConverterParameter=Downloads}"
                        ToolTip.Tip="Downloads">
                    <ui:FASymbolIcon Symbol="Download" FontSize="16" />
                </Button>
                <Button Classes="glass-nav" Command="{Binding NavigateCommand}" CommandParameter="Favorites" Padding="7,6" Margin="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="{Binding CurrentPageTag, Converter={StaticResource ActiveTagToBackgroundConverter}, ConverterParameter=Favorites}"
                        ToolTip.Tip="Favorites">
                    <ui:FASymbolIcon Symbol="Star" FontSize="16" />
                </Button>
                <Button Classes="glass-nav" Command="{Binding NavigateCommand}" CommandParameter="Settings" Padding="7,6" Margin="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="{Binding CurrentPageTag, Converter={StaticResource ActiveTagToBackgroundConverter}, ConverterParameter=Settings}"
                        ToolTip.Tip="Settings">
                    <ui:FASymbolIcon Symbol="Settings" FontSize="16" />
                </Button>
                <!-- Clicking this both runs StartCommand (no-ops if already active) and, via the
                     attached Flyout, opens the QR panel - Avalonia shows a Button's Flyout on click
                     automatically, independent of whatever its own Command does. -->
                <Button Classes="glass-nav" Command="{Binding RemoteControl.StartCommand}" Background="{StaticResource GlassPanelBrush}" Padding="7,6" Margin="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Remote control">
                    <ui:FASymbolIcon Symbol="Remote" FontSize="16" />
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Spacing="10" Width="260" Margin="4">
                                <TextBlock Text="Scan with your phone to control playback"
                                           Foreground="{StaticResource GlassTextDimBrush}"
                                           TextWrapping="Wrap" FontSize="13" />
                                <Border Background="White" CornerRadius="6" Padding="8" HorizontalAlignment="Center">
                                    <Image Source="{Binding RemoteControl.QrCodeImage}" Width="204" Height="204" />
                                </Border>
                                <TextBlock Text="{Binding RemoteControl.StatusMessage}"
                                           IsVisible="{Binding RemoteControl.HasStatusMessage}"
                                           Foreground="OrangeRed" TextWrapping="Wrap" FontSize="12" />
                                <TextBox Classes="glass" Text="{Binding RemoteControl.ConnectUrl}" IsReadOnly="True"
                                         IsVisible="{Binding RemoteControl.IsActive}"
                                         FontSize="11" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            IsVisible="{Binding RemoteControl.IsActive}">
                                    <Button Classes="glass-ctrl" Content="New Code" Command="{Binding RemoteControl.RegenerateCodeCommand}" />
                                    <Button Classes="glass-ctrl" Content="Stop" Command="{Binding RemoteControl.StopCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </UniformGrid>

            <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" />
        </Grid>

        <!-- Tinted (not Transparent) so this reads as a draggable resize handle rather than dead
             space next to the nav row - brightens further on hover/press for the usual "this is
             interactive" affordance. -->
        <GridSplitter Grid.Column="1" Width="6" Background="#2E251E"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      DragCompleted="OnContentSidebarSplitterDragCompleted">
            <GridSplitter.IsVisible>
                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                    <Binding Path="!Player.IsFullscreen" />
                    <Binding Path="!IsSettingsActive" />
                </MultiBinding>
            </GridSplitter.IsVisible>
        </GridSplitter>

        <!-- ClipToBounds is required here, not cosmetic: this column collapses to a literal
             GridLength(0) while Settings is active (see VideoColumnWidthConverter), but Grid/Panel
             doesn't clip its children to their arranged bounds by default. Without this, the idle
             logo and transport bar (centered StackPanels wider than 0px) still render at their full
             natural size, arranged around a zero-width slot pinned to the window's right edge - the
             left half of each bleeds out over whatever page (e.g. Settings) is showing. -->
        <Grid Grid.Column="2" RowDefinitions="*,Auto" ClipToBounds="True">
            <!-- No Grid.RowSpan: LibVLC's video surface always paints above Avalonia content
                 regardless of z-order, so it must not share a row with the transport bar below.
                 Also gated on NowPlayingChannelName (null until something's actually selected, and
                 reset to null by Stop()) - without that, the native surface's own opaque black paints
                 over the whole pane even when nothing has ever been played, hiding the acrylic blur
                 that should show through there. -->
            <vlc:VideoView Grid.Row="0" x:Name="MainVideoView" MediaPlayer="{Binding Player.MediaPlayer}">
                <vlc:VideoView.IsVisible>
                    <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                        <Binding Path="!Player.ShowLoadingOverlay" />
                        <Binding Path="Player.NowPlayingChannelName" Converter="{x:Static conv:ObjectConverters.IsNotNull}" />
                    </MultiBinding>
                </vlc:VideoView.IsVisible>
            </vlc:VideoView>
            <!-- Shown instead of (not over) the video while still connecting or after a hard error -
                 libVLC's native surface always paints over ordinary Avalonia content, so hiding the
                 surface above is the only way this becomes visible at all. See ShowLoadingOverlay. -->
            <Grid Grid.Row="0" Background="Black" IsVisible="{Binding Player.ShowLoadingOverlay}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <ui:FAProgressRing IsActive="{Binding Player.IsBuffering}"
                                       IsVisible="{Binding Player.IsBuffering}"
                                       Width="48" Height="48" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Player.StatusText}" Foreground="White" FontSize="16"
                               HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="400" />
                    <Button Content="Retry" Command="{Binding Player.RetryCommand}"
                            IsVisible="{Binding Player.HasPlaybackError}"
                            HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
            <!-- Idle state: nothing selected yet, and not connecting/erroring either - deliberately no
                 Background at all (not even a glass brush) so the window's own AcrylicBlur shows
                 straight through, the same "see the desktop behind it" moment Windows Terminal has
                 when a pane is otherwise empty. -->
            <Grid Grid.Row="0">
                <Grid.IsVisible>
                    <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                        <Binding Path="!Player.ShowLoadingOverlay" />
                        <Binding Path="Player.NowPlayingChannelName" Converter="{x:Static conv:ObjectConverters.IsNull}" />
                    </MultiBinding>
                </Grid.IsVisible>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <Image Source="avares://BitMagic.BennyBox/Assets/icon.png" Width="120" Height="120" Opacity="0.5" />
                    <TextBlock Text="Benny Box" FontSize="16" HorizontalAlignment="Center"
                               Foreground="{StaticResource GlassTextDimBrush}" />
                </StackPanel>
            </Grid>
            <!-- Note: this region can't be verified via the usual PrintWindow screenshot technique -
                 even the pre-glass baseline transport bar captures as empty black here, confirmed by
                 testing the unmodified HEAD commit with the same method. It's a capture limitation
                 (likely the native VideoView's compositing layer), not a real rendering absence -
                 verify this specific bar by eye in the live app, or via a real screen-pixel capture
                 (see technical-avalonia-overlay-rendering-pitfalls memory) instead. -->
            <Border Grid.Row="1" Background="{StaticResource TransportBarBrush}"
                    IsVisible="{Binding !Player.IsFullscreen}">
            <StackPanel Spacing="6" Margin="12">
                <!-- Live channels usually aren't seekable, VOD episodes always are - this row
                     only shows up when the current stream's own capabilities (not what kind of
                     thing it is) say so, so it just naturally appears/disappears as appropriate. -->
                <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding Player.IsSeekable}">
                    <TextBlock Grid.Column="0" Text="{Binding Player.PositionLabel}"
                               VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" Foreground="{StaticResource GlassTextDimBrush}" />
                    <!-- Pointer press/release handlers are wired in code-behind via AddHandler on
                         the tunnel phase, not here - Slider's internal Thumb marks those events
                         handled during the bubble phase for its own drag logic, so a plain
                         PointerPressed="..." attribute here would never fire while dragging the dot. -->
                    <Slider Grid.Column="1" x:Name="SeekSlider"
                            Minimum="0" Maximum="{Binding Player.DurationSeconds}"
                            Value="{Binding Player.SeekSliderValue}" />
                    <TextBlock Grid.Column="2" Text="{Binding Player.DurationLabel}"
                               VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" Foreground="{StaticResource GlassTextDimBrush}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <!-- Icon-only, matching the sidebar nav's look. No tooltips here - unlike the
                         sidebar (where the icon is the only label a page ever gets), these icons are
                         common/self-explanatory playback controls, and a tooltip on every one of them
                         just adds noise while moving the mouse across the bar. -->
                    <Button Classes="glass-ctrl" Command="{Binding Player.StopCommand}" Padding="10,6">
                        <ui:FASymbolIcon Symbol="StopFilled" FontSize="16" />
                    </Button>
                    <Button Classes="glass-ctrl" Command="{Binding Player.SkipBackwardCommand}" IsVisible="{Binding Player.IsSeekable}" Padding="10,6">
                        <!-- Plain double-triangle, not FASymbolIcon's PreviousFilled/NextFilled - those
                             render with a vertical bar (⏮/⏭), which reads as "previous/next track"
                             rather than "skip back/forward N seconds". Matches the glyphs the phone
                             remote (RemoteControlPage.cs) already uses for the same buttons. -->
                        <TextBlock Text="⏪" FontSize="16" />
                    </Button>
                    <Button Classes="glass-ctrl accent" Command="{Binding Player.TogglePauseCommand}" IsVisible="{Binding Player.CanPause}" Padding="10,6">
                        <ui:FASymbolIcon Symbol="{Binding Player.IsPaused, Converter={StaticResource PausedToPlaySymbolConverter}}" FontSize="16" />
                    </Button>
                    <Button Classes="glass-ctrl" Command="{Binding Player.SkipForwardCommand}" IsVisible="{Binding Player.IsSeekable}" Padding="10,6">
                        <TextBlock Text="⏩" FontSize="16" />
                    </Button>
                    <Button Classes="glass-ctrl" Command="{Binding Player.ToggleFullscreenCommand}" Padding="10,6">
                        <ui:FASymbolIcon Symbol="FullScreenMaximize" FontSize="16" />
                    </Button>
                    <Button Classes="glass-ctrl" Command="{Binding Player.ToggleMuteCommand}" Padding="10,6">
                        <ui:FASymbolIcon Symbol="{Binding Player.IsMuted, Converter={StaticResource MutedToSymbolConverter}}" FontSize="16" />
                    </Button>
                    <Slider Width="100" Minimum="0" Maximum="100"
                            Value="{Binding Player.Volume}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{Binding Player.Volume}" />
                    <ComboBox Classes="glass" ItemsSource="{Binding Player.AudioTracks}"
                              SelectedItem="{Binding Player.SelectedAudioTrack}"
                              IsVisible="{Binding Player.HasMultipleAudioTracks}"
                              Width="140" VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="vm:TrackOption">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Classes="glass" ItemsSource="{Binding Player.SubtitleTracks}"
                              SelectedItem="{Binding Player.SelectedSubtitleTrack}"
                              IsVisible="{Binding Player.HasSubtitleTracks}"
                              Width="140" VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="vm:TrackOption">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding Player.NowPlayingChannelName}" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource GlassTextBrush}" />
                    <ui:FAProgressRing IsActive="{Binding Player.ShowBufferingBadge}"
                                       IsVisible="{Binding Player.ShowBufferingBadge}"
                                       Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Player.StatusText}" VerticalAlignment="Center" Foreground="{StaticResource GlassTextDimBrush}" />
                </StackPanel>
            </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
