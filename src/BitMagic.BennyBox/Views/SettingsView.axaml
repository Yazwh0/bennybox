<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BitMagic.BennyBox.ViewModels"
             xmlns:models="using:BitMagic.BennyBox.Core.Models"
             xmlns:converters="using:Avalonia.Data.Converters"
             x:Class="BitMagic.BennyBox.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             x:Name="RootControl">
    <ScrollViewer>
    <StackPanel Margin="16" Spacing="12">
        <TextBlock Text="Settings" FontSize="24" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Theme" VerticalAlignment="Center" Width="80" />
            <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" Width="160" />
        </StackPanel>

        <TextBlock Text="Playback recovery" FontSize="18" Margin="0,12,0,0" />
        <TextBlock Text="How quickly a frozen/dropped stream is detected and offered a retry."
                   Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Connect timeout" VerticalAlignment="Center" Width="160" />
            <NumericUpDown Value="{Binding LoadTimeoutSeconds}" Minimum="3" Maximum="120" Increment="1"
                            FormatString="0" Width="140" />
            <TextBlock Text="seconds" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Stall detection" VerticalAlignment="Center" Width="160" />
            <NumericUpDown Value="{Binding StallThresholdSeconds}" Minimum="2" Maximum="60" Increment="1"
                            FormatString="0" Width="140" />
            <TextBlock Text="seconds" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Pause reconnect after" VerticalAlignment="Center" Width="160" />
            <NumericUpDown Value="{Binding PauseReconnectThresholdSeconds}" Minimum="5" Maximum="600" Increment="5"
                            FormatString="0" Width="140" />
            <TextBlock Text="seconds" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>

        <TextBlock Text="Track defaults" FontSize="18" Margin="0,12,0,0" />
        <TextBlock Text="Matched loosely against whatever name the stream/episode reports for its tracks (e.g. &quot;English&quot;) - leave blank to leave it as the stream's own default. Subtitles default to off unless a language is set here."
                   Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Preferred audio" VerticalAlignment="Center" Width="160" />
            <AutoCompleteBox Text="{Binding PreferredAudioLanguage}" ItemsSource="{Binding CommonLanguages}"
                              FilterMode="Contains" PlaceholderText="e.g. English" Width="200" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Preferred subtitles" VerticalAlignment="Center" Width="160" />
            <AutoCompleteBox Text="{Binding PreferredSubtitleLanguage}" ItemsSource="{Binding CommonLanguages}"
                              FilterMode="Contains" PlaceholderText="blank = off" Width="200" />
        </StackPanel>

        <Button Content="Add Profile" Click="OnAddProfileClick" IsEnabled="{Binding !IsBusy}" Margin="0,12,0,0" />
        <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" />
        <ItemsControl ItemsSource="{Binding Profiles}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:ProfileSource">
                    <Border BorderBrush="Gray" BorderThickness="0,0,0,1" Padding="0,8">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                <TextBlock Text="{Binding SourceType}" Opacity="0.7" FontSize="12" />
                                <TextBlock Opacity="0.7" FontSize="12"
                                           IsVisible="{Binding XtreamStatus, Converter={x:Static converters:ObjectConverters.IsNotNull}}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} · expires {1:yyyy-MM-dd} · {2} connections">
                                            <Binding Path="XtreamStatus" />
                                            <Binding Path="XtreamExpiryUtc" />
                                            <Binding Path="XtreamMaxConnections" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Edit" Margin="4,0"
                                    Click="OnEditProfileClick"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding #RootControl.DataContext.IsBusy, Converter={x:Static converters:BoolConverters.Not}}" />
                            <Button Grid.Column="2" Content="Refresh" Margin="4,0"
                                    Command="{Binding #RootControl.DataContext.RefreshProfileCommand}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding #RootControl.DataContext.IsBusy, Converter={x:Static converters:BoolConverters.Not}}" />
                            <Button Grid.Column="3" Content="Delete"
                                    Command="{Binding #RootControl.DataContext.DeleteProfileCommand}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding #RootControl.DataContext.IsBusy, Converter={x:Static converters:BoolConverters.Not}}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
    </ScrollViewer>
</UserControl>
