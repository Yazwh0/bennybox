<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BitMagic.BennyBox.ViewModels"
             xmlns:models="using:BitMagic.BennyBox.Core.Models"
             xmlns:converters="using:Avalonia.Data.Converters"
             x:Class="BitMagic.BennyBox.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             x:Name="RootControl">
    <ScrollViewer>
    <StackPanel Margin="16" Spacing="12">
        <TextBlock Text="Settings" FontSize="24" Foreground="{StaticResource GlassTextBrush}" />

        <Border Classes="glass-card" Padding="16">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Theme" VerticalAlignment="Center" Width="160" Foreground="{StaticResource GlassTextBrush}" />
                <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" Width="160" />
            </StackPanel>
        </Border>

        <Border Classes="glass-card" Padding="16">
            <StackPanel Spacing="12">
                <TextBlock Text="Playback controls" FontSize="18" Foreground="{StaticResource GlassTextBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Skip interval" VerticalAlignment="Center" Width="160" Foreground="{StaticResource GlassTextBrush}" />
                    <NumericUpDown Value="{Binding SkipIntervalSeconds}" Minimum="5" Maximum="300" Increment="5"
                                    FormatString="0" Width="140" />
                    <TextBlock Text="seconds" VerticalAlignment="Center" Foreground="{StaticResource GlassTextDimBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Classes="glass-card" Padding="16">
            <StackPanel Spacing="12">
                <TextBlock Text="Playback recovery" FontSize="18" Foreground="{StaticResource GlassTextBrush}" />
                <TextBlock Text="How quickly a frozen/dropped stream is detected and offered a retry."
                           Foreground="{StaticResource GlassTextDimBrush}" FontSize="12" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Connect timeout" VerticalAlignment="Center" Width="160" Foreground="{StaticResource GlassTextBrush}" />
                    <NumericUpDown Value="{Binding LoadTimeoutSeconds}" Minimum="3" Maximum="120" Increment="1"
                                    FormatString="0" Width="140" />
                    <TextBlock Text="seconds" VerticalAlignment="Center" Foreground="{StaticResource GlassTextDimBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Stall detection" VerticalAlignment="Center" Width="160" Foreground="{StaticResource GlassTextBrush}" />
                    <NumericUpDown Value="{Binding StallThresholdSeconds}" Minimum="2" Maximum="60" Increment="1"
                                    FormatString="0" Width="140" />
                    <TextBlock Text="seconds" VerticalAlignment="Center" Foreground="{StaticResource GlassTextDimBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Pause reconnect after" VerticalAlignment="Center" Width="160" Foreground="{StaticResource GlassTextBrush}" />
                    <NumericUpDown Value="{Binding PauseReconnectThresholdSeconds}" Minimum="5" Maximum="600" Increment="5"
                                    FormatString="0" Width="140" />
                    <TextBlock Text="seconds" VerticalAlignment="Center" Foreground="{StaticResource GlassTextDimBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Classes="glass-card" Padding="16">
            <StackPanel Spacing="12">
                <TextBlock Text="Track defaults" FontSize="18" Foreground="{StaticResource GlassTextBrush}" />
                <TextBlock Text="Matched loosely against whatever name the stream/episode reports for its tracks (e.g. &quot;English&quot;) - leave blank to leave it as the stream's own default. Subtitles default to off unless a language is set here."
                           Foreground="{StaticResource GlassTextDimBrush}" FontSize="12" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Preferred audio" VerticalAlignment="Center" Width="160" Foreground="{StaticResource GlassTextBrush}" />
                    <ComboBox ItemsSource="{Binding CommonLanguages}" SelectedItem="{Binding PreferredAudioLanguage}" Width="200" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Preferred subtitles" VerticalAlignment="Center" Width="160" Foreground="{StaticResource GlassTextBrush}" />
                    <ComboBox ItemsSource="{Binding CommonLanguages}" SelectedItem="{Binding PreferredSubtitleLanguage}" Width="200" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Classes="glass-card" Padding="16">
            <StackPanel Spacing="12">
                <TextBlock Text="Remote control" FontSize="18" Foreground="{StaticResource GlassTextBrush}" />
                <TextBlock Text="Whether the phone remote's pairing code changes every time it's started, or stays the same across restarts."
                           Foreground="{StaticResource GlassTextDimBrush}" FontSize="12" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <RadioButton Content="Session-bound (new code each time)" GroupName="RemoteKeyMode" IsChecked="{Binding IsRemoteKeySessionBound}" />
                    <RadioButton Content="Fixed (same code every time)" GroupName="RemoteKeyMode" IsChecked="{Binding IsRemoteKeyFixed}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Nothing to configure at all once a bundled key is already doing the job - the whole
             card disappears rather than showing an empty "works out of the box" notice with no
             control underneath it. -->
        <Border Classes="glass-card" Padding="16" IsVisible="{Binding !HasEmbeddedTmdbKey}">
            <StackPanel Spacing="12">
                <TextBlock Text="Metadata enrichment" FontSize="18" Foreground="{StaticResource GlassTextBrush}" />
                <TextBlock Text="Fills in a synopsis, genre, and poster for Local Folder/SFTP movies and shows that have no local NFO/poster of their own, using themoviedb.org. Leave blank to skip this entirely - local metadata always wins when it's present either way. Get a free API key at themoviedb.org (Settings &#8594; API)."
                           Foreground="{StaticResource GlassTextDimBrush}" FontSize="12" TextWrapping="Wrap" />
                <StackPanel Spacing="4">
                    <TextBlock Text="TMDb API Key" Foreground="{StaticResource GlassTextBrush}" />
                    <TextBox Classes="glass" Text="{Binding TmdbApiKey}" PlaceholderText="Not set" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- The Downloads profile itself doesn't appear in the profile list below (see
             SettingsViewModel.LoadProfilesAsync) - it's not something you Add/Edit/Refresh, it's
             managed automatically the first time you tap a download button anywhere in the app. -->
        <Border Classes="glass-card" Padding="16">
            <StackPanel Spacing="12">
                <TextBlock Text="Downloads" FontSize="18" Foreground="{StaticResource GlassTextBrush}" />
                <TextBlock Text="Where movies, episodes, and clips land when you download them for offline/faster playback. Once something's downloaded, the app plays that local copy instead of re-streaming it - see the download button on any title."
                           Foreground="{StaticResource GlassTextDimBrush}" FontSize="12" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Classes="glass" Text="{Binding DownloadsFolderPath}" IsReadOnly="True" />
                    <Button Grid.Column="1" Classes="glass-ctrl" Content="Change location..." Click="OnChangeDownloadsLocationClick" Margin="6,0,0,0" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding DownloadsDiskUsageLabel}" Foreground="{StaticResource GlassTextDimBrush}" FontSize="12" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="glass-ctrl" Content="Clear all downloads" Command="{Binding ClearAllDownloadsCommand}" IsEnabled="{Binding !IsBusy}" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Classes="glass-card" Padding="16">
            <StackPanel Spacing="12">
                <Button Classes="glass-ctrl" Content="Add Profile" Click="OnAddProfileClick" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" Foreground="{StaticResource GlassTextBrush}" />
                <ItemsControl ItemsSource="{Binding Profiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ProfileSource">
                            <Border BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{StaticResource GlassTextBrush}" />
                                        <TextBlock Text="{Binding SourceType}" Foreground="{StaticResource GlassTextDimBrush}" FontSize="12" />
                                        <TextBlock Foreground="{StaticResource GlassTextDimBrush}" FontSize="12"
                                                   IsVisible="{Binding XtreamStatus, Converter={x:Static converters:ObjectConverters.IsNotNull}}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} · expires {1:yyyy-MM-dd} · {2} connections">
                                                    <Binding Path="XtreamStatus" />
                                                    <Binding Path="XtreamExpiryUtc" />
                                                    <Binding Path="XtreamMaxConnections" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Classes="glass-nav" Grid.Column="1" Content="Edit" Margin="4,0"
                                            Click="OnEditProfileClick"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding #RootControl.DataContext.IsBusy, Converter={x:Static converters:BoolConverters.Not}}" />
                                    <Button Classes="glass-nav" Grid.Column="2" Content="Refresh" Margin="4,0"
                                            Command="{Binding #RootControl.DataContext.RefreshProfileCommand}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding #RootControl.DataContext.IsBusy, Converter={x:Static converters:BoolConverters.Not}}" />
                                    <Button Classes="glass-nav" Grid.Column="3" Content="Delete"
                                            Command="{Binding #RootControl.DataContext.DeleteProfileCommand}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding #RootControl.DataContext.IsBusy, Converter={x:Static converters:BoolConverters.Not}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>
