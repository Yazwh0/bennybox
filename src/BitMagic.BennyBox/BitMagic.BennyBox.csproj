<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UserSecretsId>7a1f523f-3640-4537-8d0a-fa1988521212</UserSecretsId>
    <AssemblyTitle>Benny Box</AssemblyTitle>
    <Product>Benny Box</Product>
    <Company>BitMagic</Company>
    <PackageId>BitMagic.BennyBox</PackageId>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <!-- AVLN3001: MainWindow has no public parameterless constructor by design - it's only ever
         constructed via DI (see App.axaml.cs), and adding one just to satisfy Avalonia's XAML
         previewer/hot-reload tooling would be a footgun (a stray `new MainWindow()` compiling but
         producing a half-wired window). The app's own XAML loading goes through the generated
         InitializeComponent(), not this reflection-based path, so it's unaffected at runtime. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Gives RemoteControlServer.cs access to Kestrel/minimal APIs without switching this project's
         SDK to Microsoft.NET.Sdk.Web - FrameworkReference is supported from any SDK-style project and
         needs no separate download (the shared framework ships with the .NET runtime already). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="FluentAvaloniaUI" />
    <PackageReference Include="LibVLCSharp" />
    <PackageReference Include="LibVLCSharp.Avalonia" />
    <PackageReference Include="QRCoder" />
    <!-- Microsoft.Extensions.Hosting/Http/Configuration.UserSecrets are deliberately NOT referenced
         here - they're already part of the Microsoft.AspNetCore.App shared framework this project
         references above (for Kestrel/RemoteControlServer), so an explicit PackageReference is
         redundant and the SDK's package-pruning advisory (NU1510) flags it as such. -->
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BitMagic.BennyBox.Core\BitMagic.BennyBox.Core.csproj" />
    <ProjectReference Include="..\BitMagic.BennyBox.Sources\BitMagic.BennyBox.Sources.csproj" />
    <ProjectReference Include="..\BitMagic.BennyBox.Data\BitMagic.BennyBox.Data.csproj" />
  </ItemGroup>
</Project>
